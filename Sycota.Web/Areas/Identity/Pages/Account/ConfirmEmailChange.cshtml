@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Потвърждение на промяна на имейл";
}

<div class="container py-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-center">
                    <h4 class="mb-3"><i class="bi bi-envelope-at me-2"></i>Промяна на имейл</h4>
                    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                    {
                        <div class="alert @(Model.StatusMessage.Contains("успешно") ? "alert-success" : "alert-danger") mb-0">
                            @Model.StatusMessage
                        </div>
                    }
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <a asp-page="/Account/Manage/Email" asp-area="Identity" class="btn btn-accent">Към настройки</a>
                </div>
            </div>
        </div>
    </div>
</div>
