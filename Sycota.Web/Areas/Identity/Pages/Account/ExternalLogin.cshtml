@page
@model ExternalLoginModel

@{
    ViewData["Title"] = "Свързване на акаунт";
}

<div class="container py-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="text-center mb-4">
                <img src="~/images/sycota.png" alt="SYCOTA" class="img-fluid" style="max-height: 80px;" />
                <p class="text-muted mt-2">Платформа за Прецизна Стрелба</p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h4 class="card-title text-center mb-4">
                        <i class="bi bi-link-45deg me-2"></i>Свързване на @Model.ProviderDisplayName акаунт
                    </h4>

                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle me-2"></i>
                        Успешно се удостоверихте с <strong>@Model.ProviderDisplayName</strong>. 
                        Моля, въведете потребителско име за завършване на регистрацията.
                    </div>

                    <form id="external-login-confirmation" asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Username" class="form-control" autocomplete="username" aria-required="true" placeholder="потребителско име" />
                            <label asp-for="Input.Username">
                                <i class="bi bi-person me-1"></i>Потребителско име
                            </label>
                            <span asp-validation-for="Input.Username" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-floating mb-4">
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email">
                                <i class="bi bi-envelope me-1"></i>Имейл
                            </label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        
                        <button type="submit" class="btn btn-accent w-100 py-2 mb-3">
                            <i class="bi bi-person-plus me-2"></i>Регистрация
                        </button>
                    </form>
                </div>
                
                <div class="card-footer bg-light text-center py-3">
                    <span class="text-muted">Вече имате акаунт?</span>
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-semibold ms-1">
                        Влезте
                    </a>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="small text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Обратно към регистрацията
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
