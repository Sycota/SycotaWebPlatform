@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container py-5 mb-5">
<div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">
        <div class="text-center mb-4">
            <img src="~/images/sycota.png" alt="SYCOTA" class="img-fluid" style="max-height: 80px;" />
            <p class="text-muted mt-2">Платформа за Прецизна Стрелба</p>
        </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h4 class="card-title text-center mb-4">
                        <i class="bi bi-person-plus me-2"></i>Създайте акаунт
                    </h4>

                    @* External Login Section *@
                    <section class="mb-4">
                        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                        {
                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    @if (provider.Name.Equals("Google", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="submit" class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2 py-2" 
                                                name="provider" value="@provider.Name" title="Регистрирайте се с Google">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                                                <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                                                <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                                                <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                                                <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
                                            </svg>
                                            <span>Регистрация с Google</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-outline-secondary w-100 mb-2" 
                                                name="provider" value="@provider.Name" title="Регистрирайте се с @provider.DisplayName">
                                            <i class="bi bi-box-arrow-in-right me-2"></i>@provider.DisplayName
                                        </button>
                                    }
                                }
                            </form>

                            <div class="d-flex align-items-center my-4">
                                <hr class="flex-grow-1">
                                <span class="px-3 text-muted small">или създайте акаунт с имейл</span>
                                <hr class="flex-grow-1">
                            </div>
                        }
                    </section>

                    @* Regular Registration Form *@
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Username" class="form-control" autocomplete="username" aria-required="true" placeholder="потребителско име" />
                            <label asp-for="Input.Username">
                                <i class="bi bi-person me-1"></i>Потребителско име
                            </label>
                            <span asp-validation-for="Input.Username" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email">
                                <i class="bi bi-envelope me-1"></i>Имейл
                            </label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="парола" />
                            <label asp-for="Input.Password">
                                <i class="bi bi-lock me-1"></i>Парола
                            </label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="потвърди парола" />
                            <label asp-for="Input.ConfirmPassword">
                                <i class="bi bi-lock-fill me-1"></i>Потвърдете паролата
                            </label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                        
                        <button id="registerSubmit" type="submit" class="btn btn-accent w-100 py-2 mb-3">
                            <i class="bi bi-person-plus me-2"></i>Регистрация
                        </button>
                        
                        <p class="text-muted small text-center mb-0">
                            С регистрацията се съгласявате с нашите
                            <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">условия за ползване</a>.
                        </p>
                    </form>
                </div>
                
                <div class="card-footer bg-light text-center py-3">
                    <span class="text-muted">Вече имате акаунт?</span>
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-semibold ms-1">
                        Влезте
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
