@page
@{
    ViewData["Title"] = "Проверете имейла си";
}

<div class="container py-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-center">
                    <h4 class="mb-3"><i class="bi bi-envelope-check me-2"></i>Проверете имейла си</h4>
                    <p class="text-muted mb-0">Ако съществува акаунт с този имейл, изпратихме линк за нулиране на паролата.</p>
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <a asp-page="./Login" class="text-decoration-none">Към вход</a>
                </div>
            </div>
        </div>
    </div>
</div>
