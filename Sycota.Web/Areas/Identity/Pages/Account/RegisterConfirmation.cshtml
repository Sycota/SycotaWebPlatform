@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Потвърждение на регистрация";
}

<div class="container py-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-center">
                    <h4 class="mb-3"><i class="bi bi-envelope-check me-2"></i>Почти готово</h4>
                    <p class="text-muted">Изпратихме имейл за потвърждение до:</p>
                    <p class="fw-semibold">@Model.Email</p>
                    <p class="text-muted mb-0">Потвърдете адреса си, за да активирате акаунта.</p>
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <a asp-page="./ResendEmailConfirmation" class="text-decoration-none">Не получихте имейл? Изпратете отново</a>
                </div>
            </div>
        </div>
    </div>
</div>
