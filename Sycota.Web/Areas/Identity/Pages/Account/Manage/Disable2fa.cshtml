@page
@model Disable2faModel
@{
    ViewData["Title"] = "Деактивиране на двуфакторна автентикация (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Това действие само деактивира 2FA.</strong>
    </p>
    <p>
        Деактивирането на 2FA не променя ключовете, използвани в приложенията за автентикация. Ако искате да промените ключа,
        използван в приложение за автентикация, трябва да <a asp-page="./ResetAuthenticator">нулирате ключовете за автентикация.</a>
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Деактивирай 2FA</button>
    </form>
</div>
