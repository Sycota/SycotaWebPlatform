@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Нулиране на ключ за автентикация";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Ако нулирате ключа за автентикация, приложението ви за автентикация няма да работи, докато не го преконфигурирате.</strong>
    </p>
    <p>
        Този процес деактивира 2FA, докато не потвърдите приложението си за автентикация.
        Ако не завършите конфигурацията на приложението за автентикация, може да загубите достъп до акаунта си.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Нулирай ключ за автентикация</button>
    </form>
</div>
