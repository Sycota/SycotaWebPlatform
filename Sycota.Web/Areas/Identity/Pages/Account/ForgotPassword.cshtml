@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Забравена парола";
}

<div class="container py-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h4 class="card-title text-center mb-4">
                        <i class="bi bi-key me-2"></i>Забравена парола
                    </h4>

                    <p class="text-muted">Въведете имейла си и ще получите линк за нулиране на паролата.</p>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="name@example.com" />
                            <label asp-for="Input.Email"><i class="bi bi-envelope me-1"></i>Имейл</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-accent w-100 py-2">
                            <i class="bi bi-send me-2"></i>Изпрати линк
                        </button>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <a asp-page="./Login" class="text-decoration-none">Назад към вход</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
