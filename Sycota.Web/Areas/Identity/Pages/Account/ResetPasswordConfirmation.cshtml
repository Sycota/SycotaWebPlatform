@page
@{
    ViewData["Title"] = "Паролата е сменена";
}

<div class="container py-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-center">
                    <h4 class="mb-3"><i class="bi bi-check-circle me-2"></i>Паролата е променена</h4>
                    <p class="text-muted mb-0">Паролата ви е обновена успешно. Вече може да влезете с новата парола.</p>
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <a asp-page="./Login" class="btn btn-accent">Към вход</a>
                </div>
            </div>
        </div>
    </div>
</div>
