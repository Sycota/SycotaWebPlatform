@model Sycota.Web.Models.ViewModels.NotificationsViewModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="container">
    <h1 class="mb-4"><i class="bi bi-bell me-2"></i>Notifications</h1>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-envelope me-2"></i>Club Invitations</span>
                    @if (Model.TotalCount > 0)
                    {
                        <span class="badge bg-danger">@Model.TotalCount pending</span>
                    }
                </div>
                <div class="card-body">
                    @if (!Model.PendingInvitations.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-envelope-open display-1 text-muted"></i>
                            <p class="text-muted mt-3">No pending invitations</p>
                            <p class="text-muted">When someone invites you to join a club, it will appear here.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var invitation in Model.PendingInvitations)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center mb-2">
                                                <i class="bi bi-bullseye text-primary me-2 fs-4"></i>
                                                <div>
                                                    <h5 class="mb-0">@invitation.Club.Name</h5>
                                                    <small class="text-muted">Invited by @invitation.CreatedBy.UserName</small>
                                                </div>
                                            </div>
                                            
                                            <div class="mb-2">
                                                <span class="badge bg-secondary me-2">@invitation.OfferedRole</span>
                                                @if (invitation.AssignedTrainer != null)
                                                {
                                                    <span class="text-muted">
                                                        <i class="bi bi-person me-1"></i>Trainer: @invitation.AssignedTrainer.User.UserName
                                                    </span>
                                                }
                                            </div>

                                            @if (!string.IsNullOrEmpty(invitation.Message))
                                            {
                                                <div class="alert alert-light py-2 mb-2">
                                                    <i class="bi bi-chat-quote me-1"></i>
                                                    <em>"@invitation.Message"</em>
                                                </div>
                                            }

                                            <div class="d-flex align-items-center text-muted small">
                                                <span class="me-3">
                                                    <i class="bi bi-calendar me-1"></i>Sent @invitation.CreatedAt.ToString("MMM dd, yyyy")
                                                </span>
                                                <span class="@(invitation.ExpiresAt < DateTime.UtcNow.AddDays(2) ? "text-danger" : "")">
                                                    <i class="bi bi-clock me-1"></i>Expires @invitation.ExpiresAt.ToString("MMM dd, yyyy")
                                                </span>
                                            </div>
                                        </div>
                                        
                                        <div class="ms-3">
                                            <a asp-controller="Clubs" asp-action="AcceptInvitation" asp-route-code="@invitation.InvitationCode" 
                                               class="btn btn-accent">
                                                <i class="bi bi-check-lg me-1"></i>View & Accept
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-info-circle me-2"></i>About Invitations
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        Club admins can invite you to join their club by sending an invitation to your email address.
                    </p>
                    <p class="text-muted small">
                        Each invitation includes:
                    </p>
                    <ul class="text-muted small">
                        <li>The club you're invited to</li>
                        <li>Your assigned role (Competitor, Trainer, or Admin)</li>
                        <li>Optionally, an assigned trainer</li>
                    </ul>
                    <p class="text-muted small mb-0">
                        Invitations expire after a set period. Make sure to accept before they expire!
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
