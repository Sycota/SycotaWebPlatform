@model Sycota.Web.Models.ViewModels.GamificationNotificationViewModel
@{
    ViewData["Title"] = "Ново постижение";
}

<div class="container py-5 text-center">
    <div class="card shadow-lg border-0 mx-auto" style="max-width: 760px; background: linear-gradient(135deg, rgba(255,193,7,0.2), rgba(111,66,193,0.15));">
        <div class="card-body p-5">
            <div class="display-4 mb-3">🏆</div>
            <h1 class="h3 mb-2">Поздравления!</h1>
            <p class="text-muted mb-4">Отключихте ново постижение</p>

            <span class="badge bg-warning text-dark fs-6 mb-3">@Model.BadgeTitle</span>
            <p class="lead mb-4">@Model.BadgeDescription</p>

            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-controller="Clubs" asp-action="Badges" asp-route-id="@Model.ClubId" class="btn btn-dark">
                    <i class="bi bi-award me-1"></i>Виж всички значки
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">Назад към известията</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
    <script>
        const duration = 2200;
        const end = Date.now() + duration;
        (function frame() {
            confetti({ particleCount: 4, angle: 60, spread: 70, origin: { x: 0 } });
            confetti({ particleCount: 4, angle: 120, spread: 70, origin: { x: 1 } });
            if (Date.now() < end) requestAnimationFrame(frame);
        }());
    </script>
}
