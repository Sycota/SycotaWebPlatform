<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>@ViewData["Title"] - SYCOTAᐩ</title>
    <meta name="title" content="@ViewData["Title"] - SYCOTAᐩ" />
    <meta name="description" content="@(ViewData["Description"] ?? "SYCOTAᐩ - Водещата платформа за прецизна стрелба в България. Управление на стрелкови клубове, проследяване на резултати, AI анализ и тренировки.")" />
    <meta name="keywords" content="@(ViewData["Keywords"] ?? "стрелба, прецизна стрелба, стрелкови клуб, ISSF, въздушна пушка, състезания, тренировки, България")" />
    <meta name="author" content="SYCOTAᐩ" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path" />
    <meta property="og:title" content="@ViewData["Title"] - SYCOTAᐩ" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "SYCOTAᐩ - Водещата платформа за прецизна стрелба в България. Управление на стрелкови клубове, проследяване на резултати и AI анализ.")" />
    <meta property="og:image" content="@Context.Request.Scheme://@Context.Request.Host/images/og-image.png" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content="SYCOTAᐩ" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path" />
    <meta name="twitter:title" content="@ViewData["Title"] - SYCOTAᐩ" />
    <meta name="twitter:description" content="@(ViewData["Description"] ?? "SYCOTAᐩ - Водещата платформа за прецизна стрелба в България.")" />
    <meta name="twitter:image" content="@Context.Request.Scheme://@Context.Request.Host/images/og-image.png" />
    
    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/apple-touch-icon.png" />
    <link rel="manifest" href="~/manifest.json" />
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#2c391f" />
    <meta name="msapplication-TileColor" content="#2c391f" />
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebSite",
        "name": "SYCOTAᐩ",
        "alternateName": "SYCOTA Plus",
        "url": "@Context.Request.Scheme://@Context.Request.Host",
        "description": "Водещата платформа за прецизна стрелба в България",
        "inLanguage": "bg-BG",
        "potentialAction": {
            "@@type": "SearchAction",
            "target": "@Context.Request.Scheme://@Context.Request.Host/Clubs?search={search_term_string}",
            "query-input": "required name=search_term_string"
        },
        "publisher": {
            "@@type": "Organization",
            "name": "SYCOTAᐩ",
            "url": "@Context.Request.Scheme://@Context.Request.Host"
        }
    }
    </script>
    
    @if (ViewData["StructuredData"] != null)
    {
        <script type="application/ld+json">
            @Html.Raw(ViewData["StructuredData"])
        </script>
    }
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sycota.Web.styles.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="page-wrapper">
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark border-bottom box-shadow mb-3" aria-label="Основна навигация">
                <div class="container-fluid">
                    <a class="navbar-brand sycota-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/sycota.png" alt="SYCOTA" style="height: 48px; filter: brightness(0) invert(1);" />
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                            aria-expanded="false" aria-label="Превключване на навигацията">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse" id="mainNavbar">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-fill me-1" aria-hidden="true"></i>Начало
                                </a>
                            </li>
                            
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @await Component.InvokeAsync("ClubsMenu")
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">
                                        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>За Нас
                                    </a>
                                </li>
                            }
                            
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-journal-text me-1" aria-hidden="true"></i>Информация
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="About">
                                            <i class="bi bi-info-circle me-2"></i>За Платформата
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Features">
                                            <i class="bi bi-stars me-2"></i>Функционалности
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Privacy">
                                            <i class="bi bi-shield-check me-2"></i>Поверителност
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Contact">
                                            <i class="bi bi-envelope me-2"></i>Контакти
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                        
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>
        
        <main role="main" class="main-content">
            <div class="container pb-5">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle me-2" aria-hidden="true"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>

        <footer class="footer py-4" style="background-color: var(--sycota-bg-dark);">
            <div class="container">
                <div class="row align-items-center gy-3">
                    <div class="col-lg-4 col-md-12 text-center text-lg-start">
                        <div class="d-flex align-items-center justify-content-center justify-content-lg-start">
                            <img src="~/images/sycota.png" alt="SYCOTA" style="height: 28px; filter: brightness(0) invert(1);" class="me-2" />
                            <span class="text-light opacity-75 small">Платформа за Прецизна Стрелба</span>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-12 text-center">
                        <ul class="list-inline mb-0 small">
                            <li class="list-inline-item">
                                <a asp-area="" asp-controller="Home" asp-action="About" class="footer-link">За Нас</a>
                            </li>
                            <li class="list-inline-item text-light opacity-50 mx-1">•</li>
                            <li class="list-inline-item">
                                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="footer-link">Поверителност</a>
                            </li>
                            <li class="list-inline-item text-light opacity-50 mx-1">•</li>
                            <li class="list-inline-item">
                                <a asp-area="" asp-controller="Home" asp-action="Terms" class="footer-link">Условия</a>
                            </li>
                            <li class="list-inline-item text-light opacity-50 mx-1">•</li>
                            <li class="list-inline-item">
                                <a asp-area="" asp-controller="Home" asp-action="Contact" class="footer-link">Контакти</a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-lg-4 col-md-12 text-center text-lg-end">
                        <a href="mailto:georgi.georgiev.highschool@buditel.bg" class="text-light opacity-75 text-decoration-none small d-block">
                            <i class="bi bi-envelope me-1"></i>georgi.georgiev.highschool@buditel.bg
                        </a>
                        <a href="mailto:ivaylo.kirilov.highschool@buditel.bg" class="text-light opacity-75 text-decoration-none small d-block">
                            <i class="bi bi-envelope me-1"></i>ivaylo.kirilov.highschool@buditel.bg
                        </a>
                    </div>
                </div>
                <hr class="my-3 opacity-25" />
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <span class="text-light opacity-50 small">&copy; 2026 SYCOTAᐩ. Всички права запазени.</span>
                    <span class="text-light opacity-50 small">Направено с <i class="bi bi-heart-fill text-danger"></i> от Георги и Ивайло</span>
                </div>
            </div>
        </footer>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
