@model Sycota.Web.Models.ViewModels.NotificationsViewModel

@if (Model.TotalCount > 0)
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle position-relative" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-bell-fill"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger notification-badge">
                @Model.TotalCount
                <span class="visually-hidden">известия</span>
            </span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark notification-dropdown">
            @if (Model.GamificationNotifications.Any())
            {
                <li class="dropdown-header">
                    <strong><i class="bi bi-award me-2"></i>Нови постижения</strong>
                </li>
                @foreach (var notification in Model.GamificationNotifications.Take(3))
                {
                    <li>
                        <a class="dropdown-item notification-item" asp-controller="Notifications" asp-action="Achievement" asp-route-notificationId="@notification.Id">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-trophy text-warning me-2 mt-1"></i>
                                <div>
                                    <strong>@notification.BadgeTitle</strong>
                                    <br />
                                    <small class="text-muted">@notification.BadgeDescription</small>
                                </div>
                            </div>
                        </a>
                    </li>
                }
                <li><hr class="dropdown-divider"></li>
            }

            <li class="dropdown-header">
                <strong><i class="bi bi-envelope me-2"></i>Покани за клубове</strong>
            </li>
            <li><hr class="dropdown-divider"></li>
            @foreach (var invitation in Model.PendingInvitations.Take(5))
            {
                <li>
                    <a class="dropdown-item notification-item" asp-controller="Clubs" asp-action="AcceptInvitation" asp-route-code="@invitation.InvitationCode">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-bullseye text-primary me-2 mt-1"></i>
                            <div>
                                <strong>@invitation.Club.Name</strong>
                                <br />
                                <small class="text-muted">
                                    Поканен като <span class="badge bg-secondary">@invitation.OfferedRole.GetDisplayName()</span>
                                </small>
                                <br />
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>Изтича на @invitation.ExpiresAt.ToString("dd.MM")
                                </small>
                            </div>
                        </div>
                    </a>
                </li>
            }
            @if (Model.TotalCount > 5 || Model.GamificationNotifications.Any())
            {
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item text-center" asp-controller="Notifications" asp-action="Index">
                        Виж всички @Model.TotalCount известия
                    </a>
                </li>
            }
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Notifications" asp-action="Index" title="Известия">
            <i class="bi bi-bell"></i>
        </a>
    </li>
}
