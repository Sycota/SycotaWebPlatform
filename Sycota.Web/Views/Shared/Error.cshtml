@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<h1 class="text-danger">Грешка.</h1>
<h2 class="text-danger">Възникна грешка при обработката на вашата заявка.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID на заявката:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Режим за разработка</h3>
<p>
    Превключването към <strong>Development</strong> среда ще покаже по-подробна информация за възникналата грешка.
</p>
<p>
    <strong>Development средата не трябва да бъде включена за публикувани приложения.</strong>
    Това може да доведе до показване на чувствителна информация от изключения на крайните потребители.
    За локално отстраняване на грешки, включете <strong>Development</strong> средата като зададете променливата <strong>ASPNETCORE_ENVIRONMENT</strong> на <strong>Development</strong>
    и рестартирате приложението.
</p>
