@{
    ViewData["Title"] = "Контакти";
    ViewData["Description"] = "Свържете се с екипа на SYCOTAᐩ. Имате въпроси или предложения? Ще се радваме да чуем от вас.";
}

<div class="container py-4 mb-5">
    <!-- Hero Section -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-envelope text-primary me-2"></i>Контакти
        </h1>
        <p class="lead text-muted col-lg-8 mx-auto">
            Имате въпроси или предложения? Ще се радваме да чуем от вас!
        </p>
    </div>

    <div class="row g-4">
        <!-- Contact Info -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h3 class="h5 mb-4">Информация за Контакт</h3>
                    
                    <div class="d-flex mb-4">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" 
                             style="width: 50px; height: 50px; background-color: rgba(47, 102, 144, 0.1); flex-shrink: 0;">
                            <i class="bi bi-envelope text-primary fs-5"></i>
                        </div>
                        <div>
                            <h6 class="mb-1">Имейл</h6>
                            <a href="mailto:georgi.georgiev.highschool@buditel.bg" class="text-decoration-none small">georgi.georgiev.highschool@buditel.bg</a>
                        </div>
                    </div>

                    <div class="d-flex mb-4">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" 
                             style="width: 50px; height: 50px; background-color: rgba(47, 102, 144, 0.1); flex-shrink: 0;">
                            <i class="bi bi-geo-alt text-primary fs-5"></i>
                        </div>
                        <div>
                            <h6 class="mb-1">Локация</h6>
                            <span class="text-muted">Варна, България</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h3 class="h5 mb-4">Изпратете ни Съобщение</h3>
                    
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="contactName" placeholder="Вашето име" required>
                                    <label for="contactName"><i class="bi bi-person me-1"></i>Вашето име</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="email" class="form-control" id="contactEmail" placeholder="Имейл адрес" required>
                                    <label for="contactEmail"><i class="bi bi-envelope me-1"></i>Имейл адрес</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <select class="form-select" id="contactSubject" required>
                                        <option value="">Изберете тема...</option>
                                        <option value="general">Общ въпрос</option>
                                        <option value="support">Техническа поддръжка</option>
                                        <option value="feedback">Обратна връзка</option>
                                        <option value="partnership">Партньорство</option>
                                        <option value="other">Друго</option>
                                    </select>
                                    <label for="contactSubject"><i class="bi bi-tag me-1"></i>Тема</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea class="form-control" id="contactMessage" placeholder="Вашето съобщение" style="height: 150px" required></textarea>
                                    <label for="contactMessage"><i class="bi bi-chat-text me-1"></i>Вашето съобщение</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-accent btn-lg w-100" disabled>
                                    <i class="bi bi-send me-2"></i>Изпрати Съобщение
                                </button>
                                <small class="text-muted d-block text-center mt-2">
                                    <i class="bi bi-info-circle me-1"></i>Формата за контакт скоро ще бъде активирана. Засега използвайте имейла.
                                </small>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- FAQ Section -->
    <div class="mt-5">
        <h3 class="text-center mb-4">Често Задавани Въпроси</h3>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="accordion" id="faqAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                Безплатна ли е платформата?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">
                                Да! SYCOTAᐩ е напълно безплатна за използване. Можете да създавате клубове, да записвате тренировки и да използвате AI анализа без никакви такси.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                Как мога да създам клуб?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">
                                След регистрация отидете в секция "Моите Клубове" и кликнете на "Създай Клуб". Попълнете информацията за вашия клуб и сте готови да каните членове.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                Поддържате ли други дисциплини освен въздушна пушка?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">
                                В момента платформата е оптимизирана за ISSF 10m Air Rifle. Планираме да добавим поддръжка за въздушен пистолет и други дисциплини в бъдеще.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
