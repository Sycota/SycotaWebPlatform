@{
    ViewData["Title"] = "Функционалности";
    ViewData["Description"] = "Открийте всички функционалности на SYCOTAᐩ - управление на клубове, проследяване на резултати, AI анализ и още.";
}

<div class="container py-4 mb-5">
    <!-- Hero Section -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-stars text-warning me-2"></i>Функционалности
        </h1>
        <p class="lead text-muted col-lg-8 mx-auto">
            Всичко необходимо за управление на стрелкови клуб и проследяване на напредъка
        </p>
    </div>

    <!-- Main Features -->
    <div class="row g-4 mb-5">
        <!-- Club Management -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" 
                             style="width: 50px; height: 50px; background-color: var(--sycota-bg-dark);">
                            <i class="bi bi-building text-white fs-5"></i>
                        </div>
                        <h3 class="h5 mb-0">Управление на Клубове</h3>
                    </div>
                    <ul class="list-unstyled text-muted mb-0">
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Създаване и конфигуриране на клуб</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Управление на членове и роли</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Система за покани и заявки</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Разпределяне на треньори към състезатели</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Преглед на статистики на клуба</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Training Sessions -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" 
                             style="width: 50px; height: 50px; background-color: var(--sycota-accent-blue);">
                            <i class="bi bi-bullseye text-white fs-5"></i>
                        </div>
                        <h3 class="h5 mb-0">Тренировъчни Сесии</h3>
                    </div>
                    <ul class="list-unstyled text-muted mb-0">
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Записване на изстрели с точни координати</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Визуализация на мишена в реално време</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Поддръжка на ISSF 10m Air Rifle стандарт</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Загряващи изстрели и серии</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Бележки и коментари към сесии</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Performance Analytics -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" 
                             style="width: 50px; height: 50px; background-color: var(--sycota-bg-medium);">
                            <i class="bi bi-graph-up-arrow text-white fs-5"></i>
                        </div>
                        <h3 class="h5 mb-0">Табло за Представяне</h3>
                    </div>
                    <ul class="list-unstyled text-muted mb-0">
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Графики за прогресия на резултатите</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Топлинна карта на попаденията</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Индекс на стабилност</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Анализ на 10-ки и вътрешни 10-ки</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Филтриране по период (7, 14, 30, 90, 365 дни)</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- AI Analysis -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100 position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 m-2">
                    <span class="badge bg-warning text-dark"><i class="bi bi-stars me-1"></i>AI</span>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" 
                             style="width: 50px; height: 50px; background: linear-gradient(135deg, #6f42c1 0%, #0d6efd 100%);">
                            <i class="bi bi-robot text-white fs-5"></i>
                        </div>
                        <h3 class="h5 mb-0">AI Анализ</h3>
                    </div>
                    <ul class="list-unstyled text-muted mb-0">
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Автоматичен анализ на сесии</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Персонализирани препоръки</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Чат с AI асистент</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Идентификация на модели и тенденции</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Съвети за подобряване на техниката</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Features -->
    <h3 class="text-center mb-4">Допълнителни Функции</h3>
    <div class="row g-3 mb-5">
        <div class="col-md-4 col-6">
            <div class="card border-0 bg-light h-100">
                <div class="card-body text-center p-3">
                    <i class="bi bi-bell fs-4 text-primary mb-2"></i>
                    <h6 class="mb-0">Известия</h6>
                    <small class="text-muted">Покани и заявки</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="card border-0 bg-light h-100">
                <div class="card-body text-center p-3">
                    <i class="bi bi-phone fs-4 text-primary mb-2"></i>
                    <h6 class="mb-0">Мобилна версия</h6>
                    <small class="text-muted">Responsive дизайн</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="card border-0 bg-light h-100">
                <div class="card-body text-center p-3">
                    <i class="bi bi-google fs-4 text-primary mb-2"></i>
                    <h6 class="mb-0">Google Login</h6>
                    <small class="text-muted">Лесна регистрация</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="card border-0 bg-light h-100">
                <div class="card-body text-center p-3">
                    <i class="bi bi-shield-lock fs-4 text-primary mb-2"></i>
                    <h6 class="mb-0">Сигурност</h6>
                    <small class="text-muted">Криптирани данни</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="card border-0 bg-light h-100">
                <div class="card-body text-center p-3">
                    <i class="bi bi-people fs-4 text-primary mb-2"></i>
                    <h6 class="mb-0">Роли</h6>
                    <small class="text-muted">Треньор, Състезател</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="card border-0 bg-light h-100">
                <div class="card-body text-center p-3">
                    <i class="bi bi-cloud fs-4 text-primary mb-2"></i>
                    <h6 class="mb-0">Облак</h6>
                    <small class="text-muted">Достъп отвсякъде</small>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="text-center py-4 rounded-3" style="background-color: rgba(47, 102, 144, 0.1);">
        <h3 class="mb-3">Готови да изпробвате?</h3>
        <p class="text-muted mb-4">Регистрирайте се безплатно и започнете да използвате SYCOTAᐩ още днес.</p>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-accent btn-lg me-2">
            <i class="bi bi-person-plus me-2"></i>Безплатна Регистрация
        </a>
        <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-primary btn-lg">
            <i class="bi bi-envelope me-2"></i>Свържете се с нас
        </a>
    </div>
</div>
