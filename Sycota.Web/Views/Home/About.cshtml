@{
    ViewData["Title"] = "За Нас";
    ViewData["Description"] = "Научете повече за SYCOTAᐩ - водещата платформа за прецизна стрелба в България.";
}

<div class="container py-4 mb-5">
    <!-- Hero Section -->
    <div class="text-center mb-5">
        <img src="~/images/sycota.png" alt="SYCOTA" class="img-fluid mb-3" style="max-height: 80px;" />
        <h1 class="display-5 fw-bold">За SYCOTAᐩ</h1>
        <p class="lead text-muted col-lg-8 mx-auto">
            Платформата, която обединява стрелковата общност в България
        </p>
    </div>

    <!-- Mission Section -->
    <div class="row align-items-center mb-5 g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, var(--sycota-bg-dark) 0%, var(--sycota-bg-medium) 100%);">
                <div class="card-body text-white p-4">
                    <h2 class="h4 mb-3">
                        <i class="bi bi-bullseye me-2"></i>Нашата Мисия
                    </h2>
                    <p class="mb-0">
                        Да предоставим на стрелковите клубове, треньори и състезатели в България 
                        модерни инструменти за управление, проследяване на резултати и анализ на представянето. 
                        Вярваме, че технологиите могат да помогнат на всеки стрелец да достигне своя потенциал.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h2 class="h4 mb-3">
                        <i class="bi bi-eye me-2 text-primary"></i>Нашата Визия
                    </h2>
                    <p class="mb-0 text-muted">
                        Да станем водещата платформа за прецизна стрелба в региона, 
                        подпомагайки развитието на спорта и създавайки общност от ентусиасти, 
                        които споделят страстта си към съвършенството в стрелбата.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="row text-center mb-5 g-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-bullseye display-4 text-primary mb-2"></i>
                    <div class="h3 fw-bold mb-0">ISSF</div>
                    <small class="text-muted">Стандарти</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-robot display-4 text-success mb-2"></i>
                    <div class="h3 fw-bold mb-0">AI</div>
                    <small class="text-muted">Анализ</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-shield-check display-4 text-info mb-2"></i>
                    <div class="h3 fw-bold mb-0">100%</div>
                    <small class="text-muted">Сигурност</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-cloud-check display-4 text-warning mb-2"></i>
                    <div class="h3 fw-bold mb-0">24/7</div>
                    <small class="text-muted">Достъпност</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Team/Values Section -->
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4">
            <h2 class="h4 mb-4 text-center">
                <i class="bi bi-heart me-2 text-danger"></i>Нашите Ценности
            </h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                             style="width: 60px; height: 60px; background-color: rgba(47, 102, 144, 0.1);">
                            <i class="bi bi-trophy fs-4 text-primary"></i>
                        </div>
                        <h5>Съвършенство</h5>
                        <p class="text-muted small">Стремим се към най-високо качество във всичко, което правим.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                             style="width: 60px; height: 60px; background-color: rgba(87, 114, 72, 0.1);">
                            <i class="bi bi-people fs-4" style="color: var(--sycota-bg-medium);"></i>
                        </div>
                        <h5>Общност</h5>
                        <p class="text-muted small">Вярваме в силата на общността и взаимопомощта.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                             style="width: 60px; height: 60px; background-color: rgba(44, 57, 31, 0.1);">
                            <i class="bi bi-lightbulb fs-4" style="color: var(--sycota-bg-dark);"></i>
                        </div>
                        <h5>Иновации</h5>
                        <p class="text-muted small">Използваме модерни технологии за подобряване на спорта.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
        <h3 class="mb-3">Готови ли сте да започнете?</h3>
        <p class="text-muted mb-4">Присъединете се към SYCOTAᐩ и станете част от бъдещето на прецизната стрелба.</p>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-accent btn-lg">
            <i class="bi bi-rocket-takeoff me-2"></i>Създайте Акаунт
        </a>
    </div>
</div>
