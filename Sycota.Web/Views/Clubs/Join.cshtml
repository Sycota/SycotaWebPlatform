@model Sycota.Web.Models.ViewModels.JoinClubViewModel
@{
    ViewData["Title"] = "Присъединяване към клуб";
    var requiresApproval = (bool?)ViewBag.RequiresApproval ?? true;
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Клубове</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.ClubId">@ViewBag.ClubName</a></li>
            <li class="breadcrumb-item active" aria-current="page">Присъединяване</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h2 class="mb-0">
                        <i class="bi bi-person-plus me-2"></i>
                        @if (requiresApproval)
                        {
                            @:Заявка за присъединяване към @ViewBag.ClubName
                        }
                        else
                        {
                            @:Присъединяване към @ViewBag.ClubName
                        }
                    </h2>
                </div>
                <div class="card-body">
                    @if (requiresApproval)
                    {
                        <div class="alert alert-warning mb-4">
                            <i class="bi bi-shield-lock me-2"></i>
                            <strong>Изисква се одобрение</strong><br />
                            <small>Този клуб изисква одобрение за присъединяване преди членуването. Вашата заявка ще бъде прегледана.</small>
                        </div>
                    }

                    <form asp-action="Join" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ClubId" />

                        <div class="mb-4">
                            <label asp-for="RequestedRole" class="form-label">Желана роля в клуба <span class="text-danger">*</span></label>
                            <select asp-for="RequestedRole" class="form-select" id="roleSelect">
                                <option value="@Sycota.Domain.Enums.ClubRole.Competitor">Състезател - участие в тренировъчни сесии</option>
                                <option value="@Sycota.Domain.Enums.ClubRole.Trainer">Треньор - управление и провеждане на тренировки</option>
                            </select>
                            <div class="form-text">
                                Изберете ролята, която най-добре описва вашата функция в този клуб.
                            </div>
                        </div>

                        <div class="mb-4" id="trainerSelection" style="display: none;">
                            <label asp-for="TrainerId" class="form-label">Изберете вашия треньор</label>
                            <select asp-for="TrainerId" class="form-select">
                                <option value="">-- Без треньор (по избор) --</option>
                                @foreach (var trainer in Model.AvailableTrainers)
                                {
                                    var trainerName = !string.IsNullOrEmpty(trainer.User?.FirstName) 
                                        ? $"{trainer.User.FirstName} {trainer.User.LastName}" 
                                        : trainer.User?.UserName;
                                    <option value="@trainer.Id">@trainerName</option>
                                }
                            </select>
                            <div class="form-text">
                                Изберете треньор, който ще наблюдава вашия напредък.
                            </div>
                        </div>

                        @if (requiresApproval)
                        {
                            <div class="mb-4">
                                <label asp-for="Message" class="form-label">Съобщение за присъединяване (по избор)</label>
                                <textarea asp-for="Message" class="form-control" rows="3" 
                                          placeholder="Представете се или обяснете защо искате да се присъедините..."></textarea>
                                <div class="form-text">
                                    Добавете кратко съобщение, за да увеличите шансовете за одобрение на вашата заявка.
                                </div>
                            </div>
                        }

                        <div class="alert alert-info">
                            <h6 class="alert-heading"><i class="bi bi-info-circle me-1"></i>Информация за ролите</h6>
                            <hr />
                            <p class="mb-1"><strong>Състезател:</strong> Участие в тренировъчни сесии, запис на резултатите си и проследяване на напредъка.</p>
                            <p class="mb-0"><strong>Треньор:</strong> Управление на тренировъчни сесии, наблюдение на състезатели и преглед на техния напредък.</p>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-accent">
                                <i class="bi bi-check-circle me-1"></i>
                                @if (requiresApproval)
                                {
                                    @:Изпрати заявка
                                }
                                else
                                {
                                    @:Присъедини се
                                }
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.ClubId" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Отказ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const roleSelect = document.getElementById('roleSelect');
            const trainerSelection = document.getElementById('trainerSelection');

            function toggleTrainerSelection() {
                if (roleSelect.value === '@((int)Sycota.Domain.Enums.ClubRole.Competitor)') {
                    trainerSelection.style.display = 'block';
                } else {
                    trainerSelection.style.display = 'none';
                }
            }

            roleSelect.addEventListener('change', toggleTrainerSelection);
            toggleTrainerSelection();
        });
    </script>
}
