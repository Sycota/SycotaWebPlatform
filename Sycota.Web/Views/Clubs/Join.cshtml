@model Sycota.Web.Models.ViewModels.JoinClubViewModel
@{
    ViewData["Title"] = "Join Club";
    var requiresApproval = (bool?)ViewBag.RequiresApproval ?? true;
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Clubs</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.ClubId">@ViewBag.ClubName</a></li>
            <li class="breadcrumb-item active" aria-current="page">Join</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h2 class="mb-0">
                        <i class="bi bi-person-plus me-2"></i>
                        @if (requiresApproval)
                        {
                            @:Request to Join @ViewBag.ClubName
                        }
                        else
                        {
                            @:Join @ViewBag.ClubName
                        }
                    </h2>
                </div>
                <div class="card-body">
                    @if (requiresApproval)
                    {
                        <div class="alert alert-warning mb-4">
                            <i class="bi bi-shield-lock me-2"></i>
                            <strong>Approval Required</strong><br />
                            <small>This club requires admin approval before you can join. Your request will be reviewed.</small>
                        </div>
                    }

                    <form asp-action="Join" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ClubId" />

                        <div class="mb-4">
                            <label asp-for="RequestedRole" class="form-label">Select Your Role <span class="text-danger">*</span></label>
                            <select asp-for="RequestedRole" class="form-select" id="roleSelect">
                                <option value="@Sycota.Domain.Enums.ClubRole.Competitor">Competitor - Participate in training sessions</option>
                                <option value="@Sycota.Domain.Enums.ClubRole.Trainer">Trainer - Train and mentor competitors</option>
                            </select>
                            <div class="form-text">
                                Choose the role that best describes your participation in this club.
                            </div>
                        </div>

                        <div class="mb-4" id="trainerSelection" style="display: none;">
                            <label asp-for="TrainerId" class="form-label">Select Your Trainer</label>
                            <select asp-for="TrainerId" class="form-select">
                                <option value="">-- No trainer (optional) --</option>
                                @foreach (var trainer in Model.AvailableTrainers)
                                {
                                    var trainerName = !string.IsNullOrEmpty(trainer.User?.FirstName) 
                                        ? $"{trainer.User.FirstName} {trainer.User.LastName}" 
                                        : trainer.User?.UserName;
                                    <option value="@trainer.Id">@trainerName</option>
                                }
                            </select>
                            <div class="form-text">
                                Select a trainer who will guide your progress.
                            </div>
                        </div>

                        @if (requiresApproval)
                        {
                            <div class="mb-4">
                                <label asp-for="Message" class="form-label">Message to Admin (optional)</label>
                                <textarea asp-for="Message" class="form-control" rows="3" 
                                          placeholder="Introduce yourself or explain why you'd like to join..."></textarea>
                                <div class="form-text">
                                    Add a personal message to help the admin review your request.
                                </div>
                            </div>
                        }

                        <div class="alert alert-info">
                            <h6 class="alert-heading"><i class="bi bi-info-circle me-1"></i>Role Information</h6>
                            <hr />
                            <p class="mb-1"><strong>Competitor:</strong> Participate in training sessions, track your results, and work with trainers.</p>
                            <p class="mb-0"><strong>Trainer:</strong> Create training sessions, manage competitors, and track their progress.</p>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-accent">
                                <i class="bi bi-check-circle me-1"></i>
                                @if (requiresApproval)
                                {
                                    @:Submit Request
                                }
                                else
                                {
                                    @:Join Club
                                }
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.ClubId" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const roleSelect = document.getElementById('roleSelect');
            const trainerSelection = document.getElementById('trainerSelection');

            function toggleTrainerSelection() {
                if (roleSelect.value === '@((int)Sycota.Domain.Enums.ClubRole.Competitor)') {
                    trainerSelection.style.display = 'block';
                } else {
                    trainerSelection.style.display = 'none';
                }
            }

            roleSelect.addEventListener('change', toggleTrainerSelection);
            toggleTrainerSelection();
        });
    </script>
}
