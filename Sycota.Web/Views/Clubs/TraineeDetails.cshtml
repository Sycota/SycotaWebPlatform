@model Sycota.Web.Models.ViewModels.TraineeDetailsViewModel
@{
    ViewData["Title"] = "Детайли за обучаем";
    var traineeName = !string.IsNullOrEmpty(Model.Trainee.User?.FirstName) 
        ? $"{Model.Trainee.User.FirstName} {Model.Trainee.User.LastName}" 
        : Model.Trainee.User?.UserName;
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Клубове</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Trainee.ClubId">@Model.Trainee.Club?.Name</a></li>
            <li class="breadcrumb-item"><a asp-action="Trainees" asp-route-id="@Model.Trainee.ClubId">Обучаеми</a></li>
            <li class="breadcrumb-item active" aria-current="page">@traineeName</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">
                        <i class="bi bi-person me-2"></i>@traineeName
                    </h2>
                    <a asp-action="TraineePerformanceDashboard" asp-route-id="@Model.Trainee.ClubId" asp-route-traineeId="@Model.Trainee.Id" 
                           class="btn btn-light btn-sm">
                            <i class="bi bi-speedometer2 me-1"></i>Табло за представяне
                        </a>
                    </div>
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-graph-up me-2"></i>История на тренировките</h5>
                    
                        @if (!Model.TrainingSessions.Any())
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-clipboard-data display-3 text-muted"></i>
                                <h5 class="mt-3 text-muted">Няма тренировъчни сесии</h5>
                                <p class="text-muted">Този обучаем все още не е записал тренировъчни сесии.</p>
                            </div>
                        }
                    else
                    {
                        <div class="table-responsive">
                        <table class="table table-hover">
                            <thead style="background-color: #495057; color: #ffffff;">
                                <tr>
                                    <th>Дата</th>
                                    <th>Име на сесията</th>
                                    <th>Тип оръжие</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                                <tbody>
                                    @foreach (var session in Model.TrainingSessions)
                                    {
                                        <tr>
                                            <td>@session.SessionDate.ToString("dd.MM.yyyy")</td>
                                            <td>@session.Name</td>
                                            <td>
                                                <span class="badge bg-secondary">@session.WeaponType</span>
                                            </td>
                                            <td>
                                                <a asp-action="TraineeSessionDetails" 
                                                   asp-route-id="@Model.Trainee.ClubId" 
                                                   asp-route-traineeId="@Model.Trainee.Id"
                                                   asp-route-sessionId="@session.Id"
                                                   class="btn btn-sm btn-outline-primary" title="Преглед на сесията">
                                                    <i class="bi bi-eye"></i> Детайли
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Trainee Info -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Информация за обучаемия</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Имейл</dt>
                        <dd class="col-sm-7">@Model.Trainee.User?.Email</dd>
                        
                        <dt class="col-sm-5">Роля</dt>
                        <dd class="col-sm-7"><span class="badge bg-info">@Model.Trainee.Role</span></dd>
                        
                        <dt class="col-sm-5">Присъединил се</dt>
                        <dd class="col-sm-7">@Model.Trainee.JoinedAt.ToString("dd.MM.yyyy")</dd>
                    </dl>
                </div>
            </div>

            <!-- Shooter Profile -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Профил на стрелеца</h5>
                </div>
                <div class="card-body">
                    @if (Model.ShooterProfile != null)
                    {
                        <dl class="row mb-0">
                            @if (Model.ShooterProfile.PrimaryWeapon.HasValue)
                            {
                                <dt class="col-sm-5">Основно оръжие</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.PrimaryWeapon</dd>
                            }
                            @if (Model.ShooterProfile.Category.HasValue)
                            {
                                <dt class="col-sm-5">Категория</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.Category</dd>
                            }
                            @if (!string.IsNullOrEmpty(Model.ShooterProfile.ISSFLicenseNumber))
                            {
                                <dt class="col-sm-5">ISSF лиценз</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.ISSFLicenseNumber</dd>
                            }
                            @if (Model.ShooterProfile.ISSFLicenseExpiryDate.HasValue)
                            {
                                <dt class="col-sm-5">Валиден до</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.ISSFLicenseExpiryDate.Value.ToString("dd.MM.yyyy")</dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Няма конфигуриран профил на стрелеца.</p>
                    }
                </div>
            </div>

            <!-- Stats -->
                        <div class="card shadow-sm">
                            <div class="card-header">
                                <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Статистика</h5>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-6">
                                        <div class="fs-3 fw-bold text-primary">@Model.TrainingSessions.Count()</div>
                                        <small class="text-muted">Сесии</small>
                                    </div>
                                    <div class="col-6">
                                        <div class="fs-3 fw-bold text-success">
                                            @{
                                                var daysSinceJoined = (DateTime.UtcNow - Model.Trainee.JoinedAt).Days;
                                            }
                                            @daysSinceJoined
                                        </div>
                                        <small class="text-muted">Дни в клуба</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <a asp-action="Trainees" asp-route-id="@Model.Trainee.ClubId" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Назад към обучаемите
                    </a>
                </div>
            </div>
