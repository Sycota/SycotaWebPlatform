@model Sycota.Web.Models.ViewModels.TraineeDetailsViewModel
@{
    ViewData["Title"] = "Trainee Details";
    var traineeName = !string.IsNullOrEmpty(Model.Trainee.User?.FirstName) 
        ? $"{Model.Trainee.User.FirstName} {Model.Trainee.User.LastName}" 
        : Model.Trainee.User?.UserName;
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Clubs</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Trainee.ClubId">@Model.Trainee.Club?.Name</a></li>
            <li class="breadcrumb-item"><a asp-action="Trainees" asp-route-id="@Model.Trainee.ClubId">Trainees</a></li>
            <li class="breadcrumb-item active" aria-current="page">@traineeName</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">
                        <i class="bi bi-person me-2"></i>@traineeName
                    </h2>
                </div>
                <div class="card-body">
                    <h5 class="mb-3"><i class="bi bi-graph-up me-2"></i>Training History</h5>
                    
                    @if (!Model.TrainingSessions.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-clipboard-data display-3 text-muted"></i>
                            <h5 class="mt-3 text-muted">No Training Sessions</h5>
                            <p class="text-muted">This trainee hasn't recorded any training sessions yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Session Name</th>
                                        <th>Weapon Type</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var session in Model.TrainingSessions)
                                    {
                                        <tr>
                                            <td>@session.SessionDate.ToString("MMM dd, yyyy")</td>
                                            <td>@session.Name</td>
                                            <td>
                                                <span class="badge bg-secondary">@session.WeaponType</span>
                                            </td>
                                            <td>@(session.Notes ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Trainee Info -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Trainee Info</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Email</dt>
                        <dd class="col-sm-7">@Model.Trainee.User?.Email</dd>
                        
                        <dt class="col-sm-5">Role</dt>
                        <dd class="col-sm-7"><span class="badge bg-info">@Model.Trainee.Role</span></dd>
                        
                        <dt class="col-sm-5">Joined</dt>
                        <dd class="col-sm-7">@Model.Trainee.JoinedAt.ToString("MMM dd, yyyy")</dd>
                    </dl>
                </div>
            </div>

            <!-- Shooter Profile -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Shooter Profile</h5>
                </div>
                <div class="card-body">
                    @if (Model.ShooterProfile != null)
                    {
                        <dl class="row mb-0">
                            @if (Model.ShooterProfile.PrimaryWeapon.HasValue)
                            {
                                <dt class="col-sm-5">Primary Weapon</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.PrimaryWeapon</dd>
                            }
                            @if (Model.ShooterProfile.Category.HasValue)
                            {
                                <dt class="col-sm-5">Category</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.Category</dd>
                            }
                            @if (!string.IsNullOrEmpty(Model.ShooterProfile.ISSFLicenseNumber))
                            {
                                <dt class="col-sm-5">ISSF License</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.ISSFLicenseNumber</dd>
                            }
                            @if (Model.ShooterProfile.ISSFLicenseExpiryDate.HasValue)
                            {
                                <dt class="col-sm-5">ISSF Expiry</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.ISSFLicenseExpiryDate.Value.ToString("MMM dd, yyyy")</dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No shooter profile configured.</p>
                    }
                </div>
            </div>

            <!-- Stats -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="fs-3 fw-bold text-primary">@Model.TrainingSessions.Count()</div>
                            <small class="text-muted">Sessions</small>
                        </div>
                        <div class="col-6">
                            <div class="fs-3 fw-bold text-success">
                                @{
                                    var daysSinceJoined = (DateTime.UtcNow - Model.Trainee.JoinedAt).Days;
                                }
                                @daysSinceJoined
                            </div>
                            <small class="text-muted">Days as Member</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Trainees" asp-route-id="@Model.Trainee.ClubId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Trainees
        </a>
    </div>
</div>
