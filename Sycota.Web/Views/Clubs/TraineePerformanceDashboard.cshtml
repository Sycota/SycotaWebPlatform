@model Sycota.Web.Models.ViewModels.TraineePerformanceDashboardViewModel
@{
    ViewData["Title"] = "Trainee Performance Dashboard";
    var selectedDays = Model.SelectedDays;
    var traineeName = !string.IsNullOrEmpty(Model.Trainee.User?.FirstName) 
        ? $"{Model.Trainee.User.FirstName} {Model.Trainee.User.LastName}" 
        : Model.Trainee.User?.UserName;
}

<div class="container-fluid mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Clubs</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Trainee.ClubId">@Model.Trainee.Club?.Name</a></li>
            <li class="breadcrumb-item"><a asp-action="Trainees" asp-route-id="@Model.Trainee.ClubId">Trainees</a></li>
            <li class="breadcrumb-item"><a asp-action="TraineeDetails" asp-route-id="@Model.Trainee.ClubId" asp-route-traineeId="@Model.Trainee.Id">@traineeName</a></li>
            <li class="breadcrumb-item active" aria-current="page">Performance Dashboard</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="mb-0">
            <i class="bi bi-speedometer2 me-2"></i>@traineeName's Performance
        </h2>
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 small">Time Period:</label>
            <div class="btn-group btn-group-sm" role="group">
                <a asp-action="TraineePerformanceDashboard" asp-route-id="@Model.Trainee.ClubId" asp-route-traineeId="@Model.Trainee.Id" asp-route-days="7" class="btn @(selectedDays == 7 ? "btn-primary" : "btn-outline-secondary")">7d</a>
                <a asp-action="TraineePerformanceDashboard" asp-route-id="@Model.Trainee.ClubId" asp-route-traineeId="@Model.Trainee.Id" asp-route-days="14" class="btn @(selectedDays == 14 ? "btn-primary" : "btn-outline-secondary")">14d</a>
                <a asp-action="TraineePerformanceDashboard" asp-route-id="@Model.Trainee.ClubId" asp-route-traineeId="@Model.Trainee.Id" asp-route-days="30" class="btn @(selectedDays == 30 ? "btn-primary" : "btn-outline-secondary")">30d</a>
                <a asp-action="TraineePerformanceDashboard" asp-route-id="@Model.Trainee.ClubId" asp-route-traineeId="@Model.Trainee.Id" asp-route-days="90" class="btn @(selectedDays == 90 ? "btn-primary" : "btn-outline-secondary")">90d</a>
                <a asp-action="TraineePerformanceDashboard" asp-route-id="@Model.Trainee.ClubId" asp-route-traineeId="@Model.Trainee.Id" asp-route-days="365" class="btn @(selectedDays == 365 ? "btn-primary" : "btn-outline-secondary")">1y</a>
            </div>
        </div>
    </div>

    @if (!Model.TrainingSessions.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-graph-up display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">No Training Data Available</h4>
                <p class="text-muted">This trainee hasn't recorded any training sessions in the selected time period.</p>
                <a asp-action="TraineeDetails" asp-route-id="@Model.Trainee.ClubId" asp-route-traineeId="@Model.Trainee.Id" class="btn btn-secondary mt-2">
                    <i class="bi bi-arrow-left me-1"></i>Back to Trainee Details
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Key Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="fs-2 fw-bold text-primary">@Model.Statistics.TotalSessions</div>
                        <small class="text-muted">Sessions</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="fs-2 fw-bold text-success">@Model.Statistics.TotalShots</div>
                        <small class="text-muted">Total Shots</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="fs-2 fw-bold" style="color: #856404;">@Model.Statistics.AverageScore.ToString("F2")</div>
                        <small class="text-muted">Avg Score/Shot</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        @{
                            var improvementClass = Model.Statistics.ImprovementPercent >= 0 ? "text-success" : "text-danger";
                            var improvementIcon = Model.Statistics.ImprovementPercent >= 0 ? "bi-arrow-up" : "bi-arrow-down";
                        }
                        <div class="fs-2 fw-bold @improvementClass">
                            <i class="bi @improvementIcon"></i>@Math.Abs(Model.Statistics.ImprovementPercent).ToString("F1")%
                        </div>
                        <small class="text-muted">Improvement</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Performance Metrics Row -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header">
                        <i class="bi bi-bullseye me-2"></i>Best & Worst Series
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="fs-3 fw-bold text-success">@Model.Statistics.BestSeriesScore.ToString("F1")</div>
                                <small class="text-muted">Best Series</small>
                            </div>
                            <div class="col-6">
                                <div class="fs-3 fw-bold text-danger">@Model.Statistics.WorstSeriesScore.ToString("F1")</div>
                                <small class="text-muted">Worst Series</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header">
                        <i class="bi bi-10-circle me-2"></i>10s Analysis
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="fs-3 fw-bold text-primary">@Model.Statistics.TotalTens</div>
                                <small class="text-muted">Total 10s</small>
                            </div>
                            <div class="col-6">
                                <div class="fs-3 fw-bold" style="color: #6f42c1;">@Model.Statistics.TotalInnerTens</div>
                                <small class="text-muted">Inner 10s</small>
                            </div>
                        </div>
                        @if (Model.Statistics.TotalShots > 0)
                        {
                            var tensPercent = (Model.Statistics.TotalTens * 100.0 / Model.Statistics.TotalShots);
                            var innerTensPercent = (Model.Statistics.TotalInnerTens * 100.0 / Model.Statistics.TotalShots);
                            <div class="progress mt-3" style="height: 20px;">
                                <div class="progress-bar" role="progressbar" style="width: @innerTensPercent%; background-color: #6f42c1;" 
                                     title="Inner 10s: @innerTensPercent.ToString("F1")%">
                                    @if (innerTensPercent > 5)
                                    {
                                        <span>@innerTensPercent.ToString("F0")%</span>
                                    }
                                </div>
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @((tensPercent - innerTensPercent))%;"
                                     title="10s: @((tensPercent - innerTensPercent).ToString("F1"))%">
                                    @if ((tensPercent - innerTensPercent) > 5)
                                    {
                                        <span>@((tensPercent - innerTensPercent).ToString("F0"))%</span>
                                    }
                                </div>
                            </div>
                            <div class="text-center mt-2">
                                <small class="text-muted">@tensPercent.ToString("F1")% of shots are 10s</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header">
                        <i class="bi bi-activity me-2"></i>Consistency Score
                    </div>
                    <div class="card-body text-center">
                        <div class="position-relative d-inline-block">
                            <svg width="120" height="120" viewBox="0 0 120 120">
                                <circle cx="60" cy="60" r="50" fill="none" stroke="#e9ecef" stroke-width="10"/>
                                @{
                                    var circumference = 2 * Math.PI * 50;
                                    var offset = circumference - (Model.Statistics.ConsistencyScore / 100 * circumference);
                                    var consistencyColor = Model.Statistics.ConsistencyScore >= 80 ? "#198754" :
                                                          Model.Statistics.ConsistencyScore >= 60 ? "#ffc107" : "#dc3545";
                                }
                                <circle cx="60" cy="60" r="50" fill="none" stroke="@consistencyColor" stroke-width="10"
                                        stroke-dasharray="@circumference" stroke-dashoffset="@offset"
                                        transform="rotate(-90 60 60)" stroke-linecap="round"/>
                            </svg>
                            <div class="position-absolute top-50 start-50 translate-middle">
                                <div class="fs-4 fw-bold">@Model.Statistics.ConsistencyScore.ToString("F0")</div>
                                <small class="text-muted">/ 100</small>
                            </div>
                        </div>
                        <p class="text-muted mb-0 mt-2">
                            @if (Model.Statistics.ConsistencyScore >= 80)
                            {
                                <span class="text-success">Excellent consistency!</span>
                            }
                            else if (Model.Statistics.ConsistencyScore >= 60)
                            {
                                <span class="text-warning">Good, keep improving</span>
                            }
                            else
                            {
                                <span class="text-danger">Work on consistency</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row g-3 mb-4">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-graph-up me-2"></i>Score Progression</span>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-secondary active" id="chartDailyBtn">Daily</button>
                            <button type="button" class="btn btn-outline-secondary" id="chartSeriesBtn">By Series</button>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="scoreProgressionChart" height="300"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header">
                        <i class="bi bi-bullseye me-2"></i>Shot Placement Heat Map
                    </div>
                    <div class="card-body text-center">
                        <canvas id="heatMapCanvas" width="280" height="280" style="max-width: 100%;"></canvas>
                        <p class="text-muted small mt-2 mb-0">
                            Aggregated shot placement from all sessions
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 10s Progression Chart -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <i class="bi bi-bar-chart me-2"></i>10s Progression (Per Series)
                    </div>
                    <div class="card-body">
                        <canvas id="tensProgressionChart" height="150"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Series Table -->
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <i class="bi bi-table me-2"></i>Recent Series Performance
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead style="background-color: #495057; color: #ffffff;">
                            <tr>
                                <th>Date</th>
                                <th>Session</th>
                                <th>Series</th>
                                <th class="text-end">Score</th>
                                <th class="text-end">Avg/Shot</th>
                                <th class="text-end">10s</th>
                                <th class="text-end">Inner 10s</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var series in Model.Statistics.RecentSeries.Take(10))
                            {
                                var rowClass = series.Score >= 100 ? "table-success" : series.Score < 90 ? "table-warning" : "";
                                <tr class="@rowClass">
                                    <td>@series.Date.ToString("MMM dd")</td>
                                    <td>@series.SessionName</td>
                                    <td>Series @series.SeriesNumber</td>
                                    <td class="text-end fw-bold">@series.Score.ToString("F1")</td>
                                    <td class="text-end">@series.AveragePerShot.ToString("F2")</td>
                                    <td class="text-end">
                                        <span class="badge bg-primary">@series.Tens</span>
                                    </td>
                                    <td class="text-end">
                                        <span class="badge" style="background-color: #6f42c1;">@series.InnerTens</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-action="TraineeDetails" asp-route-id="@Model.Trainee.ClubId" asp-route-traineeId="@Model.Trainee.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Trainee Details
        </a>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function() {
    const chartData = @Html.Raw(Model.ChartDataJson);
    const heatMapData = @Html.Raw(Model.HeatMapDataJson);

    // Score Progression Chart
    let scoreChart = null;
    const scoreChartCtx = document.getElementById('scoreProgressionChart')?.getContext('2d');
    
    function createDailyChart() {
        if (scoreChart) scoreChart.destroy();
        scoreChart = new Chart(scoreChartCtx, {
            type: 'line',
            data: {
                labels: chartData.dailyLabels || [],
                datasets: [{
                    label: 'Average Score/Shot',
                    data: chartData.dailyScores || [],
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                    fill: true,
                    tension: 0.3,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: false,
                        min: 8,
                        max: 11,
                        title: { display: true, text: 'Score per Shot' }
                    }
                }
            }
        });
    }

    function createSeriesChart() {
        if (scoreChart) scoreChart.destroy();
        scoreChart = new Chart(scoreChartCtx, {
            type: 'bar',
            data: {
                labels: chartData.seriesLabels || [],
                datasets: [{
                    label: 'Series Score',
                    data: chartData.seriesScores || [],
                    backgroundColor: chartData.seriesScores?.map(score => 
                        score >= 100 ? '#198754' : score >= 95 ? '#0d6efd' : '#ffc107'
                    ) || [],
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: false,
                        min: 80,
                        max: 109,
                        title: { display: true, text: 'Series Score' }
                    }
                }
            }
        });
    }

    if (scoreChartCtx && chartData.dailyLabels?.length > 0) {
        createDailyChart();
    }

    document.getElementById('chartDailyBtn')?.addEventListener('click', function() {
        this.classList.add('active');
        document.getElementById('chartSeriesBtn').classList.remove('active');
        createDailyChart();
    });

    document.getElementById('chartSeriesBtn')?.addEventListener('click', function() {
        this.classList.add('active');
        document.getElementById('chartDailyBtn').classList.remove('active');
        createSeriesChart();
    });

    // 10s Progression Chart
    const tensChartCtx = document.getElementById('tensProgressionChart')?.getContext('2d');
    if (tensChartCtx && chartData.seriesLabels?.length > 0) {
        new Chart(tensChartCtx, {
            type: 'bar',
            data: {
                labels: chartData.seriesLabels,
                datasets: [
                    {
                        label: 'Inner 10s',
                        data: chartData.innerTensProgression || [],
                        backgroundColor: '#6f42c1',
                        stack: 'Stack 0'
                    },
                    {
                        label: '10s',
                        data: (chartData.tensProgression || []).map((t, i) => t - (chartData.innerTensProgression?.[i] || 0)),
                        backgroundColor: '#0d6efd',
                        stack: 'Stack 0'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top' }
                },
                scales: {
                    x: { stacked: true },
                    y: { 
                        stacked: true,
                        max: 10,
                        title: { display: true, text: '10s per Series' }
                    }
                }
            }
        });
    }

    // Heat Map Canvas
    const heatMapCanvas = document.getElementById('heatMapCanvas');
    if (heatMapCanvas) {
        const ctx = heatMapCanvas.getContext('2d');
        const width = heatMapCanvas.width;
        const height = heatMapCanvas.height;
        const centerX = width / 2;
        const centerY = height / 2;
        const scale = 5;

        ctx.fillStyle = '#f5f0e6';
        ctx.fillRect(0, 0, width, height);

        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(centerX, centerY, 25 * scale, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = '#000000';
        ctx.beginPath();
        ctx.arc(centerX, centerY, 17.5 * scale, 0, Math.PI * 2);
        ctx.fill();

        for (let ring = 1; ring <= 10; ring++) {
            const radius = (25 - (ring - 1) * 2.5) * scale;
            ctx.beginPath();
            ctx.arc(centerX, centerY, radius, 0, Math.PI * 2);
            ctx.strokeStyle = ring >= 4 ? '#ffffff' : '#000000';
            ctx.lineWidth = 0.5;
            ctx.stroke();
        }

        ctx.beginPath();
        ctx.arc(centerX, centerY, 0.25 * scale, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();

        if (heatMapData.shots && heatMapData.shots.length > 0) {
            const shotCounts = {};
            const gridSize = 2;

            heatMapData.shots.forEach(shot => {
                const gridX = Math.round(shot.x / gridSize) * gridSize;
                const gridY = Math.round(shot.y / gridSize) * gridSize;
                const key = gridX + ',' + gridY;
                shotCounts[key] = (shotCounts[key] || 0) + 1;
            });

            const maxCount = Math.max(...Object.values(shotCounts), 1);

            Object.entries(shotCounts).forEach(function(entry) {
                const parts = entry[0].split(',');
                const x = parseFloat(parts[0]);
                const y = parseFloat(parts[1]);
                const count = entry[1];
                const intensity = count / maxCount;
                
                ctx.beginPath();
                ctx.arc(centerX + x * scale, centerY + y * scale, gridSize * scale * 0.8, 0, Math.PI * 2);
                
                const r = Math.floor(intensity * 255);
                const g = Math.floor((1 - intensity) * 100);
                const b = Math.floor((1 - intensity) * 255);
                ctx.fillStyle = 'rgba(' + r + ', ' + g + ', ' + b + ', ' + (0.3 + intensity * 0.5) + ')';
                ctx.fill();
            });

            heatMapData.shots.forEach(shot => {
                ctx.beginPath();
                ctx.arc(centerX + shot.x * scale, centerY + shot.y * scale, 2, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(220, 53, 69, 0.6)';
                ctx.fill();
            });

            if (heatMapData.shots.length > 0) {
                const avgX = heatMapData.shots.reduce((sum, s) => sum + s.x, 0) / heatMapData.shots.length;
                const avgY = heatMapData.shots.reduce((sum, s) => sum + s.y, 0) / heatMapData.shots.length;
                
                ctx.strokeStyle = '#00ff00';
                ctx.lineWidth = 2;
                
                ctx.beginPath();
                ctx.moveTo(centerX + avgX * scale, centerY + avgY * scale - 8);
                ctx.lineTo(centerX + avgX * scale, centerY + avgY * scale + 8);
                ctx.stroke();
                
                ctx.beginPath();
                ctx.moveTo(centerX + avgX * scale - 8, centerY + avgY * scale);
                ctx.lineTo(centerX + avgX * scale + 8, centerY + avgY * scale);
                ctx.stroke();
                
                ctx.beginPath();
                ctx.arc(centerX + avgX * scale, centerY + avgY * scale, 4, 0, Math.PI * 2);
                ctx.fillStyle = '#00ff00';
                ctx.fill();
            }
        }
    }
})();
</script>
}
