@model Sycota.Web.Models.ViewModels.ManageRequestsViewModel
@{
    ViewData["Title"] = "Управление на заявки - " + Model.Club.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-people-fill me-2"></i>Управление на заявки</h1>
    <a asp-action="Details" asp-route-id="@Model.Club.Id" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i>Към клуба
    </a>
</div>

<div class="row mb-5">
<div class="col-12 mb-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-person-plus me-2"></i>Чакащи заявки за членство</span>
            <span class="badge bg-warning text-dark">@Model.PendingRequests.Count()</span>
        </div>
        <div class="card-body">
            @if (!Model.PendingRequests.Any())
            {
                <p class="text-muted mb-0"><i class="bi bi-info-circle me-2"></i>Няма чакащи заявки за членство.</p>
            }
                else
                {
                    <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Потребител</th>
                                <th>Желана роля</th>
                                <th>Желан треньор</th>
                                <th>Съобщение</th>
                                <th>Заявена на</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                            <tbody>
                                @foreach (var request in Model.PendingRequests)
                                {
                                    <tr>
                                        <td>
                                            <strong>@request.User.UserName</strong><br />
                                            <small class="text-muted">@request.User.Email</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@request.RequestedRole</span>
                                        </td>
                                        <td>
                                            @if (request.RequestedTrainer != null)
                                            {
                                                <span>@request.RequestedTrainer.User.UserName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Няма</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(request.Message))
                                            {
                                                <small>@request.Message</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@request.RequestedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>
                                            <form asp-action="ApproveRequest" asp-route-id="@Model.Club.Id" asp-route-requestId="@request.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="bi bi-check-lg"></i> Одобри
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal-@request.Id">
                                                <i class="bi bi-x-lg"></i> Отхвърли
                                            </button>

                                            <!-- Reject Modal -->
                                            <div class="modal fade" id="rejectModal-@request.Id" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <form asp-action="RejectRequest" asp-route-id="@Model.Club.Id" asp-route-requestId="@request.Id" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <div class="modal-header">
                                                                <h5 class="modal-title">Отхвърляне на заявка</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p>Сигурни ли сте, че искате да отхвърлите заявката на <strong>@request.User.UserName</strong>?</p>
                                                                <div class="mb-3">
                                                                    <label class="form-label">Причина (по избор)</label>
                                                                    <textarea name="reason" class="form-control" rows="3"></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отказ</button>
                                                                <button type="submit" class="btn btn-danger">Отхвърли заявката</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-envelope me-2"></i>Изпратени покани</span>
            <a asp-action="Invite" asp-route-id="@Model.Club.Id" class="btn btn-accent btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Изпрати покана
            </a>
        </div>
        <div class="card-body">
            @if (!Model.PendingInvitations.Any())
            {
                <p class="text-muted mb-0"><i class="bi bi-info-circle me-2"></i>Няма изпратени покани.</p>
            }
                else
                {
                    <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Имейл</th>
                                <th>Предложена роля</th>
                                <th>Назначен треньор</th>
                                <th>Изпратена от</th>
                                <th>Валидна до</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                            <tbody>
                                @foreach (var invitation in Model.PendingInvitations)
                                {
                                    <tr>
                                        <td>@invitation.Email</td>
                                        <td>
                                            <span class="badge bg-secondary">@invitation.OfferedRole</span>
                                        </td>
                                        <td>
                                            @if (invitation.AssignedTrainer != null)
                                                {
                                                    <span>@invitation.AssignedTrainer.User.UserName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Няма</span>
                                                }
                                            </td>
                                            <td>@invitation.CreatedBy.UserName</td>
                                            <td>
                                                @if (invitation.ExpiresAt < DateTime.UtcNow)
                                                {
                                                    <span class="text-danger">Изтекла</span>
                                                }
                                            else
                                            {
                                                @invitation.ExpiresAt.ToString("dd.MM.yyyy HH:mm")
                                            }
                                        </td>
                                        <td>
                                            <form asp-action="CancelInvitation" asp-route-id="@Model.Club.Id" asp-route-invitationId="@invitation.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Сигурни ли сте, че искате да отмените тази покана?');">
                                                    <i class="bi bi-x-lg"></i> Отмени
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
