@model Sycota.Web.Models.ViewModels.ClubInventoryViewModel
@using Sycota.Domain.Enums
@{
    ViewData["Title"] = "Инвентар - " + Model.Club.Name;
    var canManage = Model.CurrentMembership.Role == ClubRole.Admin;
    var canIssue = Model.CurrentMembership.CanTrain;
}

<div class="container mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="mb-0">Инвентар на @Model.Club.Name</h1>
        <a asp-action="Details" asp-route-id="@Model.Club.Id" class="btn btn-outline-secondary">Към клуба</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="h3 mb-1">@Model.Weapons.Count()</div>
                    <div class="text-muted small">Оръжия</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="h3 mb-1">@Model.AmmoBatches.Count()</div>
                    <div class="text-muted small">Партиди патрони</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="h3 mb-1">@Model.Issues.Count()</div>
                    <div class="text-muted small">Последни издавания</div>
                </div>
            </div>
        </div>
    </div>

    @if (canManage)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">Добавяне в инвентара</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">Администраторите могат да добавят нови оръжия и нови партиди патрони.</p>
                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="border rounded p-3 h-100">
                            <h6 class="mb-3">Ново оръжие</h6>
                            <form asp-action="AddWeapon" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ClubId" value="@Model.Club.Id" />
                                <div class="mb-2">
                                    <label class="form-label small text-muted">Сериен номер</label>
                                    <input name="SerialNumber" class="form-control" placeholder="Напр. AR-2026-015" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small text-muted">Модел</label>
                                    <input name="Model" class="form-control" placeholder="Напр. Feinwerkbau 800" />
                                </div>
                                <button type="submit" class="btn btn-accent">Добави оръжие</button>
                            </form>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="border rounded p-3 h-100">
                            <h6 class="mb-3">Нова партида патрони</h6>
                            <form asp-action="AddAmmo" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ClubId" value="@Model.Club.Id" />
                                <div class="mb-2">
                                    <label class="form-label small text-muted">Сериен номер на партида</label>
                                    <input name="SerialNumber" class="form-control" placeholder="Напр. LOT-22LR-051" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small text-muted">Тип</label>
                                    <select name="Type" class="form-select">
                                        <option value="@((int)AmmoType.Pellet10m)">10m Pellet Case</option>
                                        <option value="@((int)AmmoType.Lr22_50m)">50m .22lr</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small text-muted">Количество</label>
                                    <input name="Quantity" type="number" min="1" class="form-control" placeholder="Брой" />
                                </div>
                                <button type="submit" class="btn btn-accent">Добави патрони</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (canIssue && !Model.Shooters.Any())
    {
        <div class="alert alert-warning mb-4">
            Няма налични състезатели в клуба. Добавете състезатели, за да можете да издавате оръжия и патрони.
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Оръжия</h5>
            <span class="badge bg-secondary">@Model.Weapons.Count()</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Weapons.Any())
            {
                <div class="p-3 text-muted">Няма добавени оръжия.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Сериен №</th>
                                <th>Модел</th>
                                <th>Ползвател</th>
                                @if (canManage || canIssue)
                                {
                                    <th class="pe-3" style="min-width:420px;">Действия</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var weapon in Model.Weapons)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@weapon.SerialNumber</td>
                                    <td>@weapon.Model</td>
                                    <td>@(weapon.AssignedShooter?.User?.UserName ?? "-")</td>
                                    @if (canManage || canIssue)
                                    {
                                        <td class="pe-3">
                                            @if (canManage)
                                            {
                                                <form asp-action="EditWeapon" method="post" class="d-flex flex-wrap gap-1 mb-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="Id" value="@weapon.Id" />
                                                    <input type="hidden" name="ClubId" value="@Model.Club.Id" />
                                                    <input type="hidden" name="AssignedShooterId" value="@weapon.AssignedShooterId" />
                                                    <input name="SerialNumber" class="form-control form-control-sm" style="max-width:140px" value="@weapon.SerialNumber" />
                                                    <input name="Model" class="form-control form-control-sm" style="max-width:180px" value="@weapon.Model" />
                                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Запази</button>
                                                    <button type="submit" formaction="@Url.Action("DeleteWeapon", "Clubs")" formmethod="post" name="id" value="@weapon.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('Сигурни ли сте, че искате да изтриете това оръжие?');">Изтрий</button>
                                                </form>
                                            }
                                            @if (canIssue)
                                            {
                                                <form asp-action="IssueWeapon" method="post" class="d-flex flex-wrap gap-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="ClubId" value="@Model.Club.Id" />
                                                    <input type="hidden" name="WeaponId" value="@weapon.Id" />
                                                    <select name="ShooterId" class="form-select form-select-sm" style="max-width:220px">
                                                        @foreach (var shooter in Model.Shooters)
                                                        {
                                                            <option value="@shooter.Id">@shooter.User?.UserName</option>
                                                        }
                                                    </select>
                                                    <button type="submit" class="btn btn-outline-primary btn-sm" @(Model.Shooters.Any() ? null : "disabled")>Издай</button>
                                                </form>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Патрони</h5>
                    <span class="badge bg-secondary">@Model.AmmoBatches.Count()</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.AmmoBatches.Any())
                    {
                        <div class="p-3 text-muted">Няма добавени патрони.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-3">Сериен №</th>
                                        <th>Тип</th>
                                        <th>Остава</th>
                                        @if (canManage || canIssue)
                                        {
                                            <th class="pe-3" style="min-width: 460px;">Действия</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ammo in Model.AmmoBatches)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold">@ammo.SerialNumber</td>
                                            <td>@(ammo.Type == AmmoType.Pellet10m ? "10m Pellet Case" : "50m .22lr")</td>
                                            <td>@ammo.RemainingQuantity / @ammo.Quantity</td>
                                            @if (canManage || canIssue)
                                            {
                                                <td class="pe-3">
                                                    @if (canManage)
                                                    {
                                                        <form asp-action="EditAmmo" method="post" class="d-flex flex-wrap gap-1 mb-1">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="Id" value="@ammo.Id" />
                                                            <input type="hidden" name="ClubId" value="@Model.Club.Id" />
                                                            <input name="SerialNumber" class="form-control form-control-sm" style="max-width:140px" value="@ammo.SerialNumber" />
                                                            <select name="Type" class="form-select form-select-sm" style="max-width:120px">
                                                                <option value="@((int)AmmoType.Pellet10m)" selected="@(ammo.Type == AmmoType.Pellet10m ? "selected" : null)">10m</option>
                                                                <option value="@((int)AmmoType.Lr22_50m)" selected="@(ammo.Type == AmmoType.Lr22_50m ? "selected" : null)">50m .22lr</option>
                                                            </select>
                                                            <input name="Quantity" type="number" min="1" class="form-control form-control-sm" style="max-width:80px" value="@ammo.Quantity" />
                                                            <input name="RemainingQuantity" type="number" min="0" class="form-control form-control-sm" style="max-width:80px" value="@ammo.RemainingQuantity" />
                                                            <button type="submit" class="btn btn-outline-secondary btn-sm">Запази</button>
                                                            <button type="submit" formaction="@Url.Action("DeleteAmmo", "Clubs")" formmethod="post" name="id" value="@ammo.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('Сигурни ли сте, че искате да изтриете тази партида?');">Изтрий</button>
                                                        </form>
                                                    }
                                                    @if (canIssue)
                                                    {
                                                        <form asp-action="IssueAmmo" method="post" class="d-flex flex-wrap gap-1">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="ClubId" value="@Model.Club.Id" />
                                                            <input type="hidden" name="AmmoId" value="@ammo.Id" />
                                                            <select name="ShooterId" class="form-select form-select-sm" style="max-width:220px">
                                                                @foreach (var shooter in Model.Shooters)
                                                                {
                                                                    <option value="@shooter.Id">@shooter.User?.UserName</option>
                                                                }
                                                            </select>
                                                            <input name="Quantity" type="number" min="1" class="form-control form-control-sm" style="max-width:90px" placeholder="Бр." />
                                                            <button type="submit" class="btn btn-outline-primary btn-sm" @(Model.Shooters.Any() ? null : "disabled")>Издай</button>
                                                        </form>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0">Последни издавания</h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Issues.Any())
            {
                <div class="p-3 text-muted">Няма история на издавания.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Дата</th>
                                <th>Стрелец</th>
                                <th>Издадено</th>
                                <th class="pe-3">Издадено от</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var issue in Model.Issues)
                            {
                                <tr>
                                    <td class="ps-3">@issue.IssuedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@issue.Shooter?.User?.UserName</td>
                                    <td>
                                        @if (issue.Weapon != null)
                                        {
                                            <span>Оръжие: @issue.Weapon.SerialNumber (@issue.Weapon.Model)</span>
                                        }
                                        else if (issue.Ammo != null)
                                        {
                                            <span>Патрони: @issue.Ammo.SerialNumber (@issue.AmmoQuantity бр.)</span>
                                        }
                                    </td>
                                    <td class="pe-3">@issue.IssuedBy?.User?.UserName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
