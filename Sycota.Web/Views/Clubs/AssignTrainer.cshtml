@model Sycota.Web.Models.ViewModels.AssignTrainerViewModel
@{
    ViewData["Title"] = "Назначаване на треньор";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Клубове</a></li>
            <li class="breadcrumb-item"><a asp-action="ManageMembers" asp-route-id="@Model.ClubId">Управление на членове</a></li>
            <li class="breadcrumb-item active" aria-current="page">Назначаване на треньор</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Назначаване на треньор</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-4">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-person-fill fs-3 me-3"></i>
                            <div>
                                <strong>Състезател:</strong><br />
                                <span class="fs-5">@Model.CompetitorName</span>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CurrentTrainerName))
                    {
                        <div class="mb-4">
                            <small class="text-muted">Текущо назначен на:</small>
                            <div class="d-flex align-items-center mt-1">
                                <span class="badge bg-warning text-dark fs-6">
                                    <i class="bi bi-person-badge me-1"></i>@Model.CurrentTrainerName
                                </span>
                            </div>
                        </div>
                    }

                    <form asp-action="AssignTrainer" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ClubId" />
                        <input type="hidden" asp-for="CompetitorId" />
                        <input type="hidden" asp-for="CompetitorName" />

                        <div class="mb-4">
                            <label asp-for="SelectedTrainerId" class="form-label">Изберете треньор</label>
                            <select asp-for="SelectedTrainerId" class="form-select form-select-lg">
                                <option value="">-- Без треньор (премахни назначението) --</option>
                                @foreach (var trainer in Model.AvailableTrainers)
                                {
                                    var trainerName = !string.IsNullOrEmpty(trainer.User?.FirstName) 
                                        ? $"{trainer.User.FirstName} {trainer.User.LastName}" 
                                        : trainer.User?.UserName;
                                    var isCurrentTrainer = trainer.Id == Model.CurrentTrainerId;
                                    <option value="@trainer.Id" selected="@isCurrentTrainer">
                                        @trainerName @(isCurrentTrainer ? "(текущ)" : "")
                                    </option>
                                }
                            </select>
                            <div class="form-text">
                                Изберете треньор за този състезател или изберете "Без треньор", за да премахнете текущото назначение.
                            </div>
                        </div>

                        @if (!Model.AvailableTrainers.Any())
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Няма налични треньори</strong><br />
                                <small>Все още няма треньори в този клуб. Може да добавите треньори от админ.</small>
                            </div>
                        }

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-accent" @(Model.AvailableTrainers.Any() || Model.CurrentTrainerId.HasValue ? "" : "disabled")>
                                <i class="bi bi-check-lg me-1"></i>
                                @if (Model.CurrentTrainerId.HasValue)
                                {
                                    @:Смени назначението
                                }
                                else
                                {
                                    @:Назначи треньор
                                }
                            </button>
                            <a asp-action="ManageMembers" asp-route-id="@Model.ClubId" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Назад
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model.AvailableTrainers.Any())
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <i class="bi bi-info-circle me-2"></i>Налични треньори
                    </div>
                    <div class="card-body">
                        <div class="list-group list-group-flush">
                            @foreach (var trainer in Model.AvailableTrainers)
                            {
                                var trainerName = !string.IsNullOrEmpty(trainer.User?.FirstName) 
                                    ? $"{trainer.User.FirstName} {trainer.User.LastName}" 
                                    : trainer.User?.UserName;
                                var isCurrentTrainer = trainer.Id == Model.CurrentTrainerId;
                                <div class="list-group-item d-flex justify-content-between align-items-center @(isCurrentTrainer ? "bg-light" : "")">
                                    <div>
                                        <strong>@trainerName</strong>
                                        @if (isCurrentTrainer)
                                        {
                                            <span class="badge bg-success ms-2">Текущ</span>
                                        }
                                        <br /><small class="text-muted">@trainer.User?.Email</small>
                                    </div>
                                    <span class="badge bg-info">
                                        @trainer.Competitors.Count обучаеми
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
