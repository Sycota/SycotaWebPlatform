@model Sycota.Web.Models.ViewModels.ClubIndexViewModel
@{
    ViewData["Title"] = "Моите клубове";
    ViewData["Description"] = "Всички клубове, в които членувате в SYCOTAᐩ.";
    ViewData["Keywords"] = "стрелкови клубове, ISSF клубове, въздушна пушка клуб, състезателна стрелба, България";
}

<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary">
            <i class="bi bi-bullseye me-2" aria-hidden="true"></i>Моите Клубове
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Създай Клуб
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
        </div>
    }

    @if (!Model.Clubs.Any())
    {
        <section class="text-center py-5" aria-labelledby="no-clubs-title">
            <i class="bi bi-building display-1 text-muted" aria-hidden="true"></i>
            <h2 id="no-clubs-title" class="mt-3 text-muted">Все още не членувате в клуб</h2>
            <p class="text-muted">Създайте нов клуб, за да започнете.</p>
            <a asp-action="Create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Създайте Своя Клуб
            </a>
        </section>
    }
    else
    {
        <section aria-label="Списък с клубове">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var club in Model.Clubs)
                {
                    var memberCount = club.Members?.Count ?? 0;

                    <div class="col">
                        <article class="card h-100 shadow-sm border-primary">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h2 class="card-title h5">@club.Name</h2>
                                    <span class="badge bg-primary">Член</span>
                                </div>
                                <p class="card-text text-muted">@(club.Description.Length > 100 ? club.Description.Substring(0, 100) + "..." : club.Description)</p>
                                
                                <div class="d-flex align-items-center text-muted small mb-2">
                                    <i class="bi bi-geo-alt me-1" aria-hidden="true"></i>
                                    <span>@club.Address</span>
                                </div>
                                
                                <div class="d-flex align-items-center text-muted small">
                                    <i class="bi bi-people me-1" aria-hidden="true"></i>
                                    <span>@memberCount @(memberCount == 1 ? "член" : "члена")</span>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-top-0">
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@club.Id" class="btn btn-outline-primary flex-grow-1">
                                        <i class="bi bi-eye me-1" aria-hidden="true"></i>Преглед
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        </section>
    }
</div>
