@model Sycota.Web.Models.ViewModels.GamificationOverviewViewModel
@{
    ViewData["Title"] = "Прогрес";
}

<div class="container mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Клубове</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.CurrentMembership.ClubId">@Model.CurrentMembership.Club?.Name</a></li>
            <li class="breadcrumb-item"><a asp-action="MyResults" asp-route-id="@Model.CurrentMembership.ClubId">Моите резултати</a></li>
            <li class="breadcrumb-item active" aria-current="page">Прогрес</li>
        </ol>
    </nav>

    <div class="card shadow-sm mb-4">
        <div class="card-body p-4" style="background: linear-gradient(135deg, rgba(13,110,253,0.1), rgba(111,66,193,0.12));">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h3 class="mb-1">@Model.RankTitle</h3>
                    <div class="text-muted">Ниво @Model.Level</div>
                </div>
                <div class="text-end">
                    <div class="fs-4 fw-bold text-primary">@Model.TotalXp XP</div>
                    <small class="text-muted">Следващо ниво: @Model.NextLevelXp XP</small>
                </div>
            </div>
            <div class="progress mt-3" style="height: 12px;">
                <div class="progress-bar" style="width:@(Math.Min(100, (int)((double)Model.TotalXp / Math.Max(1, Model.NextLevelXp) * 100)))%"></div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow-sm h-100"><div class="card-body text-center"><div class="fs-2 fw-bold text-success">@Model.CurrentStreakDays</div><small class="text-muted">Текуща серия (дни)</small></div></div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100"><div class="card-body text-center"><div class="fs-2 fw-bold text-warning">@Model.BestStreakDays</div><small class="text-muted">Най-добра серия</small></div></div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100"><div class="card-body text-center"><div class="fs-2 fw-bold text-primary">@Math.Min(Model.WeeklyChallengeProgress, Model.WeeklyChallengeTarget)/@Model.WeeklyChallengeTarget</div><small class="text-muted">Седмична цел</small></div></div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.NextMilestone))
    {
        <div class="alert alert-info mt-4 mb-0">@Model.NextMilestone</div>
    }
</div>
