@model Sycota.Web.Models.ViewModels.BadgesPageViewModel
@{
    ViewData["Title"] = "Постижения";
}

<div class="container mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Клубове</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.CurrentMembership.ClubId">@Model.CurrentMembership.Club?.Name</a></li>
            <li class="breadcrumb-item"><a asp-action="MyResults" asp-route-id="@Model.CurrentMembership.ClubId">Моите резултати</a></li>
            <li class="breadcrumb-item active" aria-current="page">Постижения</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0"><i class="bi bi-award me-2"></i>Отключени значки</h2>
        <span class="badge bg-dark">@Model.Badges.Count()</span>
    </div>

    @if (!Model.Badges.Any())
    {
        <div class="alert alert-secondary">Все още няма отключени значки.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var badge in Model.Badges)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100 border-0" style="background: linear-gradient(180deg, rgba(255,255,255,0.95), rgba(248,249,250,0.95));">
                        <div class="card-body">
                            <span class="badge bg-@badge.ColorClass mb-2">@badge.Title</span>
                            <p class="mb-0 text-muted">@badge.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
