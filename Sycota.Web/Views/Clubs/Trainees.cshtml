@model Sycota.Web.Models.ViewModels.TraineesViewModel
@{
    ViewData["Title"] = "My Trainees";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Clubs</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.TrainerMembership.ClubId">@Model.TrainerMembership.Club?.Name</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Trainees</li>
        </ol>
    </nav>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h2 class="mb-0">
                <i class="bi bi-people me-2"></i>My Trainees
            </h2>
        </div>
        <div class="card-body">
            @if (!Model.Trainees.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-x display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">No Trainees Assigned</h4>
                    <p class="text-muted">Competitors will appear here once they select you as their trainer.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var trainee in Model.Trainees)
                    {
                        var traineeName = !string.IsNullOrEmpty(trainee.User?.FirstName) 
                            ? $"{trainee.User.FirstName} {trainee.User.LastName}" 
                            : trainee.User?.UserName;

                        <div class="col">
                            <div class="card h-100">
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                             style="width: 48px; height: 48px;">
                                            <i class="bi bi-person fs-4"></i>
                                        </div>
                                        <div class="ms-3">
                                            <h5 class="card-title mb-0">@traineeName</h5>
                                            <small class="text-muted">@trainee.User?.Email</small>
                                        </div>
                                    </div>

                                    @if (trainee.ShooterProfile != null)
                                    {
                                        <div class="mb-2">
                                            @if (trainee.ShooterProfile.PrimaryWeapon.HasValue)
                                            {
                                                <span class="badge bg-secondary me-1">@trainee.ShooterProfile.PrimaryWeapon</span>
                                            }
                                            @if (trainee.ShooterProfile.Category.HasValue)
                                            {
                                                <span class="badge bg-info">@trainee.ShooterProfile.Category</span>
                                            }
                                        </div>
                                    }

                                    <small class="text-muted">
                                        <i class="bi bi-calendar me-1"></i>Joined @trainee.JoinedAt.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                                <div class="card-footer bg-transparent">
                                    <a asp-action="TraineeDetails" 
                                       asp-route-id="@Model.TrainerMembership.ClubId" 
                                       asp-route-traineeId="@trainee.Id" 
                                       class="btn btn-outline-primary w-100">
                                        <i class="bi bi-graph-up me-1"></i>View Progress
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="mt-4">
        <div class="alert alert-light border">
            <h5><i class="bi bi-info-circle me-2"></i>Trainer Dashboard</h5>
            <p class="mb-0">
                As a trainer, you can monitor your trainees' progress, review their training sessions, 
                and help them improve their shooting skills. Click on any trainee to see their detailed results.
            </p>
        </div>
    </div>
</div>
