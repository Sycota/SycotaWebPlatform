@model Sycota.Web.Models.ViewModels.ClubDetailsViewModel
@{
    ViewData["Title"] = Model.Club.Name;
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Clubs</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Club.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">
                        <i class="bi bi-bullseye me-2"></i>@Model.Club.Name
                    </h2>
                    @if (Model.Club.RequiresApproval)
                    {
                        <span class="badge bg-secondary" title="Join requests require admin approval">
                            <i class="bi bi-shield-lock"></i> Approval Required
                        </span>
                    }
                </div>
                <div class="card-body">
                    <p class="lead">@Model.Club.Description</p>
                    
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <h6 class="text-muted text-uppercase small">Address</h6>
                            <p><i class="bi bi-geo-alt me-1"></i>@Model.Club.Address</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted text-uppercase small">Contact</h6>
                            @if (!string.IsNullOrEmpty(Model.Club.ContactEmail))
                            {
                                <p class="mb-1"><i class="bi bi-envelope me-1"></i>@Model.Club.ContactEmail</p>
                            }
                            @if (!string.IsNullOrEmpty(Model.Club.ContactPhone))
                            {
                                <p><i class="bi bi-telephone me-1"></i>@Model.Club.ContactPhone</p>
                            }
                        </div>
                    </div>
                    
                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="bi bi-calendar me-1"></i>Created @Model.Club.CreatedAt.ToString("MMMM dd, yyyy")
                        </small>
                    </div>
                </div>
            </div>

            <!-- Members Section -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-people me-2"></i>Members (@Model.Members.Count())</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Members.Any())
                    {
                        <p class="text-muted">No members yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Role</th>
                                        <th>Joined</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var member in Model.Members)
                                    {
                                        <tr>
                                            <td>
                                                @(member.User?.FirstName) @(member.User?.LastName)
                                                @if (string.IsNullOrEmpty(member.User?.FirstName))
                                                {
                                                    @member.User?.UserName
                                                }
                                            </td>
                                            <td>
                                                @switch (member.Role)
                                                {
                                                    case Sycota.Domain.Enums.ClubRole.Admin:
                                                        <span class="badge bg-danger">Admin</span>
                                                        @if (member.IsAlsoTrainer)
                                                        {
                                                            <span class="badge bg-warning text-dark">Trainer</span>
                                                        }
                                                        break;
                                                    case Sycota.Domain.Enums.ClubRole.Trainer:
                                                        <span class="badge bg-warning text-dark">Trainer</span>
                                                        break;
                                                    case Sycota.Domain.Enums.ClubRole.Competitor:
                                                        <span class="badge bg-info">Competitor</span>
                                                        break;
                                                }
                                            </td>
                                            <td>@member.JoinedAt.ToString("MMM dd, yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Admin Actions Card -->
            @if (Model.IsAdmin)
            {
                <div class="card shadow-sm mb-4 border-warning">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Admin Panel</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a asp-action="ManageMembers" asp-route-id="@Model.Club.Id" class="btn btn-warning">
                                <i class="bi bi-people-fill me-1"></i>Manage Members
                            </a>
                            <a asp-action="ManageRequests" asp-route-id="@Model.Club.Id" class="btn btn-outline-warning position-relative">
                                <i class="bi bi-person-plus me-1"></i>Manage Requests
                                @if (Model.PendingRequestsCount > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                        @Model.PendingRequestsCount
                                        <span class="visually-hidden">pending requests</span>
                                    </span>
                                }
                            </a>
                            <a asp-action="Invite" asp-route-id="@Model.Club.Id" class="btn btn-outline-warning">
                                <i class="bi bi-envelope-plus me-1"></i>Invite Member
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- Actions Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Actions</h5>
                </div>
                <div class="card-body">
                    @if (Model.CurrentMembership != null)
                    {
                        <div class="alert alert-info mb-3">
                            <small>
                                <i class="bi bi-person-badge me-1"></i>
                                You are a <strong>@Model.CurrentMembership.Role</strong>
                                @if (Model.CurrentMembership.Role == Sycota.Domain.Enums.ClubRole.Admin && Model.CurrentMembership.IsAlsoTrainer)
                                {
                                    <span class="badge bg-warning text-dark ms-1">+ Trainer</span>
                                }
                            </small>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-action="MyResults" asp-route-id="@Model.Club.Id" class="btn btn-primary">
                                <i class="bi bi-graph-up me-1"></i>My Results
                            </a>

                            @if (Model.IsTrainer || (Model.CurrentMembership.Role == Sycota.Domain.Enums.ClubRole.Admin && Model.CurrentMembership.IsAlsoTrainer))
                            {
                                <a asp-action="Trainees" asp-route-id="@Model.Club.Id" class="btn btn-accent">
                                    <i class="bi bi-people me-1"></i>My Trainees
                                </a>
                            }

                            <hr />

                            <form asp-action="Leave" asp-route-id="@Model.Club.Id" method="post" 
                                  onsubmit="return confirm('Are you sure you want to leave this club?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger w-100">
                                    <i class="bi bi-box-arrow-left me-1"></i>Leave Club
                                </button>
                            </form>
                        </div>
                    }
                    else if (Model.HasPendingRequest)
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-hourglass-split me-2"></i>
                            <strong>Request Pending</strong><br />
                            <small>Your request to join this club is awaiting admin approval.</small>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-3">Join this club to access training sessions and results.</p>
                        <a asp-action="Join" asp-route-id="@Model.Club.Id" class="btn btn-accent w-100">
                            <i class="bi bi-person-plus me-1"></i>
                            @if (Model.Club.RequiresApproval)
                            {
                                @:Request to Join
                            }
                            else
                            {
                                @:Join Club
                            }
                        </a>
                    }
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Club Stats</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="fs-4 fw-bold text-primary">@Model.Members.Count()</div>
                            <small class="text-muted">Members</small>
                        </div>
                        <div class="col-4">
                            <div class="fs-4 fw-bold text-warning">@Model.Trainers.Count()</div>
                            <small class="text-muted">Trainers</small>
                        </div>
                        <div class="col-4">
                            <div class="fs-4 fw-bold text-info">@Model.Competitors.Count()</div>
                            <small class="text-muted">Competitors</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
