@model Sycota.Web.Models.ViewModels.MyResultsViewModel
@{
    ViewData["Title"] = "Моите резултати";
    var isCompetitor = Model.CurrentMembership.Role == Sycota.Domain.Enums.ClubRole.Competitor;
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Клубове</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.CurrentMembership.ClubId">@Model.CurrentMembership.Club?.Name</a></li>
            <li class="breadcrumb-item active" aria-current="page">Моите резултати</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h2 class="mb-0">
                    <i class="bi bi-graph-up me-2"></i>Моите тренировъчни резултати
                </h2>
                <div class="d-flex gap-2">
                    <a asp-action="PerformanceDashboard" asp-route-id="@Model.CurrentMembership.ClubId" class="btn btn-outline-primary">
                        <i class="bi bi-speedometer2 me-1"></i>Табло за представяне
                    </a>
                    <a asp-controller="TrainingSessions" asp-action="Create" asp-route-id="@Model.CurrentMembership.ClubId" class="btn btn-accent">
                        <i class="bi bi-plus-circle me-1"></i>Нова сесия
                    </a>
                </div>
            </div>
                <div class="card-body">
                    @if (!Model.TrainingSessions.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-clipboard-data display-1 text-muted"></i>
                            <h4 class="mt-3 text-muted">Все още няма тренировъчни сесии</h4>
                            <p class="text-muted">Запишете си изстрелите, за да видите напредъка си тук!</p>
                            <a asp-controller="TrainingSessions" asp-action="Create" asp-route-id="@Model.CurrentMembership.ClubId" class="btn btn-accent btn-lg mt-2">
                                <i class="bi bi-plus-circle me-1"></i>Запиши първата си сесия
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                        <table class="table table-hover">
                            <thead style="background-color: #495057; color: #ffffff;">
                                <tr>
                                    <th>Дата</th>
                                    <th>Име на сесията</th>
                                    <th>Тип оръжие</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                                <tbody>
                                    @foreach (var session in Model.TrainingSessions)
                                    {
                                        <tr>
                                            <td>@session.SessionDate.ToString("dd.MM.yyyy")</td>
                                            <td>
                                                <a asp-controller="TrainingSessions" asp-action="Details" asp-route-id="@session.Id" class="text-decoration-none">
                                                    @session.Name
                                                </a>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@session.WeaponType</span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-controller="TrainingSessions" asp-action="Details" asp-route-id="@session.Id" class="btn btn-outline-primary" title="Детайли">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a asp-controller="TrainingSessions" asp-action="RecordShots" asp-route-id="@session.Id" class="btn btn-outline-secondary" title="Редактирай">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <form asp-controller="TrainingSessions" asp-action="Delete" asp-route-id="@session.Id" method="post" class="d-inline"
                                                          onsubmit="return confirm('Сигурни ли сте, че искате да изтриете тази тренировъчна сесия? Всички изстрели от нея ще бъдат изгубени.');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-danger" title="Изтрий">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Shooter Profile -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Профил на стрелеца</h5>
                </div>
                <div class="card-body">
                    @if (Model.ShooterProfile != null)
                    {
                        <dl class="row mb-0">
                            @if (Model.ShooterProfile.PrimaryWeapon.HasValue)
                            {
                                <dt class="col-sm-5">Основно оръжие</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.PrimaryWeapon</dd>
                            }
                            @if (Model.ShooterProfile.Category.HasValue)
                            {
                                <dt class="col-sm-5">Категория</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.Category</dd>
                            }
                            @if (!string.IsNullOrEmpty(Model.ShooterProfile.ISSFLicenseNumber))
                            {
                                <dt class="col-sm-5">ISSF лиценз</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.ISSFLicenseNumber</dd>
                            }
                            @if (!string.IsNullOrEmpty(Model.ShooterProfile.NationalLicenseNumber))
                            {
                                <dt class="col-sm-5">Национален лиценз</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.NationalLicenseNumber</dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Няма конфигуриран профил на стрелеца.</p>
                    }
                </div>
            </div>

            <!-- Summary Stats -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Статистика</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="fs-3 fw-bold text-primary">@Model.TrainingSessions.Count()</div>
                            <small class="text-muted">Брой сесии</small>
                        </div>
                        <div class="col-6">
                            <div class="fs-3 fw-bold text-success">
                                @(Model.TrainingSessions.Any() ? Model.TrainingSessions.Max(s => s.SessionDate).ToString("MMM") : "-")
                            </div>
                            <small class="text-muted">Последна активност</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
