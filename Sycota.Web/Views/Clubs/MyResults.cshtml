@model Sycota.Web.Models.ViewModels.MyResultsViewModel
@{
    ViewData["Title"] = "My Results";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Clubs</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.CurrentMembership.ClubId">@Model.CurrentMembership.Club?.Name</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Results</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">
                        <i class="bi bi-graph-up me-2"></i>My Training Results
                    </h2>
                    <a asp-controller="TrainingSessions" asp-action="Create" asp-route-id="@Model.CurrentMembership.ClubId" class="btn btn-accent">
                        <i class="bi bi-plus-circle me-1"></i>New Session
                    </a>
                </div>
                <div class="card-body">
                    @if (!Model.TrainingSessions.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-clipboard-data display-1 text-muted"></i>
                            <h4 class="mt-3 text-muted">No Training Sessions Yet</h4>
                            <p class="text-muted">Start training to see your results here!</p>
                            <a asp-controller="TrainingSessions" asp-action="Create" asp-route-id="@Model.CurrentMembership.ClubId" class="btn btn-accent btn-lg mt-2">
                                <i class="bi bi-plus-circle me-1"></i>Record Your First Session
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead style="background-color: #495057; color: #ffffff;">
                                    <tr>
                                        <th>Date</th>
                                        <th>Session Name</th>
                                        <th>Weapon Type</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var session in Model.TrainingSessions)
                                    {
                                        <tr>
                                            <td>@session.SessionDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <a asp-controller="TrainingSessions" asp-action="Details" asp-route-id="@session.Id" class="text-decoration-none">
                                                    @session.Name
                                                </a>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@session.WeaponType</span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-controller="TrainingSessions" asp-action="Details" asp-route-id="@session.Id" class="btn btn-outline-primary" title="View">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a asp-controller="TrainingSessions" asp-action="RecordShots" asp-route-id="@session.Id" class="btn btn-outline-secondary" title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <form asp-controller="TrainingSessions" asp-action="Delete" asp-route-id="@session.Id" method="post" class="d-inline"
                                                          onsubmit="return confirm('Are you sure you want to delete this training session? This action cannot be undone.');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Shooter Profile -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Shooter Profile</h5>
                </div>
                <div class="card-body">
                    @if (Model.ShooterProfile != null)
                    {
                        <dl class="row mb-0">
                            @if (Model.ShooterProfile.PrimaryWeapon.HasValue)
                            {
                                <dt class="col-sm-5">Primary Weapon</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.PrimaryWeapon</dd>
                            }
                            @if (Model.ShooterProfile.Category.HasValue)
                            {
                                <dt class="col-sm-5">Category</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.Category</dd>
                            }
                            @if (!string.IsNullOrEmpty(Model.ShooterProfile.ISSFLicenseNumber))
                            {
                                <dt class="col-sm-5">ISSF License</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.ISSFLicenseNumber</dd>
                            }
                            @if (!string.IsNullOrEmpty(Model.ShooterProfile.NationalLicenseNumber))
                            {
                                <dt class="col-sm-5">National License</dt>
                                <dd class="col-sm-7">@Model.ShooterProfile.NationalLicenseNumber</dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No shooter profile configured.</p>
                    }
                </div>
            </div>

            <!-- Summary Stats -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="fs-3 fw-bold text-primary">@Model.TrainingSessions.Count()</div>
                            <small class="text-muted">Total Sessions</small>
                        </div>
                        <div class="col-6">
                            <div class="fs-3 fw-bold text-success">
                                @(Model.TrainingSessions.Any() ? Model.TrainingSessions.Max(s => s.SessionDate).ToString("MMM") : "-")
                            </div>
                            <small class="text-muted">Last Active</small>
                        </div>
                    </div>

                    @if (Model.CurrentMembership.Trainer != null)
                    {
                        <hr />
                        <div class="text-center">
                            <small class="text-muted">Your Trainer</small>
                            <p class="mb-0 fw-bold">
                                @(Model.CurrentMembership.Trainer.User?.FirstName ?? Model.CurrentMembership.Trainer.User?.UserName)
                                @Model.CurrentMembership.Trainer.User?.LastName
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
