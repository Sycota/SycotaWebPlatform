@model Sycota.Web.Models.ViewModels.AdminSessionsViewModel
@{
    ViewData["Title"] = "?????????? ?? ??????????";
}

<div class="container mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">????? ?????</a></li>
            <li class="breadcrumb-item active">??????????</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-calendar-event me-2"></i>??????????</h1>
    </div>

    <!-- Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label class="form-label">???????</label>
                    <input type="text" name="search" class="form-control" placeholder="????? ?? ???, ????????, ???? ??? ??????????..." value="@Model.SearchTerm" />
                </div>
                <div class="col-md-3">
                    <div class="d-grid gap-2 d-md-flex">
                        <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i>?????</button>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-action="Sessions" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Sessions Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>???</th>
                            <th>????</th>
                            <th>????????</th>
                            <th>????</th>
                            <th>??????</th>
                            <th class="text-end">????????</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model.Sessions)
                        {
                            var creatorName = session.CreatedBy != null
                                ? (!string.IsNullOrEmpty(session.CreatedBy.FirstName)
                                    ? $"{session.CreatedBy.FirstName} {session.CreatedBy.LastName}"
                                    : session.CreatedBy.UserName)
                                : "??????????";
                            <tr>
                                <td><small class="text-muted">@session.Id</small></td>
                                <td><strong>@session.Name</strong></td>
                                <td><small>@(session.Club?.Name ?? "—")</small></td>
                                <td><small>@creatorName</small></td>
                                <td><small class="text-muted">@session.SessionDate.ToString("dd.MM.yyyy HH:mm")</small></td>
                                <td><span class="badge bg-secondary">@session.WeaponType.GetDisplayName()</span></td>
                                <td class="text-end">
                                    <a asp-action="EditSession" asp-route-id="@session.Id" class="btn btn-sm btn-outline-primary me-1" title="??????????">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteSession" asp-route-id="@session.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('??????? ?? ???, ?? ?????? ?? ???????? ?????????? @session.Name?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="??????">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted">
            ????: @Model.Sessions.Count() ??????????(?)
        </div>
    </div>
</div>
