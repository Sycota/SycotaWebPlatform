@model Sycota.Web.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "????? ?????";
}

<div class="container mb-5">
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-shield-lock-fill fs-2 me-3 text-danger"></i>
        <div>
            <h1 class="mb-0">????? ?????</h1>
            <small class="text-muted">?????????? ?? ???????????</small>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <div class="fs-1 fw-bold text-primary">@Model.TotalUsers</div>
                    <small class="text-muted"><i class="bi bi-people me-1"></i>???????????</small>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-3">
                    <a asp-action="Users" class="btn btn-sm btn-outline-primary">??? ??????</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <div class="fs-1 fw-bold text-success">@Model.TotalClubs</div>
                    <small class="text-muted"><i class="bi bi-bullseye me-1"></i>???????</small>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-3">
                    <a asp-action="Clubs" class="btn btn-sm btn-outline-success">??? ??????</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <div class="fs-1 fw-bold text-info">@Model.TotalSessions</div>
                    <small class="text-muted"><i class="bi bi-calendar-event me-1"></i>??????????</small>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-3">
                    <a asp-action="Sessions" class="btn btn-sm btn-outline-info">??? ??????</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <div class="fs-1 fw-bold text-warning">@Model.TotalMembers</div>
                    <small class="text-muted"><i class="bi bi-person-badge me-1"></i>????????</small>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-3">
                    <a asp-action="Members" class="btn btn-sm btn-outline-warning">??? ??????</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Users -->
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-people me-2"></i>???????? ???????????</span>
                    <a asp-action="Users" class="btn btn-sm btn-outline-secondary">??? ??????</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>??????????</th>
                                    <th>?????</th>
                                    <th>?????</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.RecentUsers)
                                {
                                    <tr>
                                        <td>
                                            <strong>@user.UserName</strong>
                                            @if (!string.IsNullOrEmpty(user.FirstName))
                                            {
                                                <br /><small class="text-muted">@user.FirstName @user.LastName</small>
                                            }
                                        </td>
                                        <td><small>@user.Email</small></td>
                                        <td>
                                            @if (user.IsAdmin)
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-shield-check"></i></span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Clubs -->
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-bullseye me-2"></i>???????? ???????</span>
                    <a asp-action="Clubs" class="btn btn-sm btn-outline-secondary">??? ??????</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>????</th>
                                    <th>???????</th>
                                    <th>????</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var club in Model.RecentClubs)
                                {
                                    <tr>
                                        <td><strong>@club.Name</strong></td>
                                        <td><span class="badge bg-secondary">@club.Members.Count</span></td>
                                        <td><small class="text-muted">@club.CreatedAt.ToString("dd.MM.yyyy")</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
