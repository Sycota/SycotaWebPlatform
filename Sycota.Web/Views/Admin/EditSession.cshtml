@model Sycota.Web.Models.ViewModels.AdminEditSessionViewModel
@{
    ViewData["Title"] = $"??????????? ?? {Model.Name}";
}

<div class="container mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">????? ?????</a></li>
            <li class="breadcrumb-item"><a asp-action="Sessions">??????????</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h2 class="mb-0"><i class="bi bi-pencil me-2"></i>??????????? ?? ??????????</h2>
                </div>
                <div class="card-body">
                    <form asp-action="EditSession" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ClubId" />

                        <div class="alert alert-info">
                            <div class="row">
                                <div class="col-md-6">
                                    <small class="text-muted d-block">????</small>
                                    <strong>@Model.ClubName</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">????????</small>
                                    <strong>@Model.CreatedByName</strong>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">??? ?? ????????????</label>
                            <input asp-for="Name" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">????????</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="SessionDate" class="form-label">???? ? ???</label>
                                <input asp-for="SessionDate" class="form-control" type="datetime-local" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="WeaponType" class="form-label">??? ??????</label>
                                <select asp-for="WeaponType" asp-items="Html.GetEnumSelectList<Sycota.Domain.Enums.ISSFWeaponType>()" class="form-select"></select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">???????</label>
                            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                        </div>

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Sessions" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>?????
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>?????? ?????????
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
