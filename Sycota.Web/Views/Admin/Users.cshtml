@model Sycota.Web.Models.ViewModels.AdminUsersViewModel
@{
    ViewData["Title"] = "?????????? ?? ???????????";
}

<div class="container mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">????? ?????</a></li>
            <li class="breadcrumb-item active">???????????</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-people me-2"></i>???????????</h1>
    </div>

    <!-- Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label class="form-label">???????</label>
                    <input type="text" name="search" class="form-control" placeholder="????? ?? ???, ????????????? ??? ??? ?????..." value="@Model.SearchTerm" />
                </div>
                <div class="col-md-3">
                    <div class="d-grid gap-2 d-md-flex">
                        <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i>?????</button>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-action="Users" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>??????????</th>
                            <th>?????</th>
                            <th>???</th>
                            <th class="text-center">?????</th>
                            <th class="text-center">????? ?????????</th>
                            <th class="text-end">????????</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td><strong>@user.UserName</strong></td>
                                <td><small>@user.Email</small></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.FirstName))
                                    {
                                        @($"{user.FirstName} {user.LastName}")
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (user.IsAdmin)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-shield-check me-1"></i>??</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (user.EmailConfirmed)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle text-muted"></i>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('??????? ?? ???, ?? ?????? ?? ???????? ?????????? @user.UserName? ???? ?? ?????? ?????? ???????? ?????.')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted">
            ????: @Model.Users.Count() ??????????(?)
        </div>
    </div>
</div>
