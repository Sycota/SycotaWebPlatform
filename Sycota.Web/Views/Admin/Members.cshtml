@model Sycota.Web.Models.ViewModels.AdminMembersViewModel
@{
    ViewData["Title"] = "?????????? ?? ????????";
}

<div class="container mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">????? ?????</a></li>
            <li class="breadcrumb-item active">????????</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-person-badge me-2"></i>????????</h1>
    </div>

    <!-- Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label class="form-label">???????</label>
                    <input type="text" name="search" class="form-control" placeholder="????? ?? ?????????? ??? ????..." value="@Model.SearchTerm" />
                </div>
                <div class="col-md-3">
                    <div class="d-grid gap-2 d-md-flex">
                        <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i>?????</button>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-action="Members" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Members Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>??????????</th>
                            <th>????</th>
                            <th>????</th>
                            <th>???????</th>
                            <th>???????????</th>
                            <th class="text-end">????????</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Members)
                        {
                            var memberName = member.User != null
                                ? (!string.IsNullOrEmpty(member.User.FirstName)
                                    ? $"{member.User.FirstName} {member.User.LastName}"
                                    : member.User.UserName)
                                : "??????????";

                            var trainerName = member.Trainer?.User != null
                                ? (!string.IsNullOrEmpty(member.Trainer.User.FirstName)
                                    ? $"{member.Trainer.User.FirstName} {member.Trainer.User.LastName}"
                                    : member.Trainer.User.UserName)
                                : null;

                            var roleBadgeClass = member.Role switch
                            {
                                Sycota.Domain.Enums.ClubRole.Admin => "bg-danger",
                                Sycota.Domain.Enums.ClubRole.Trainer => "bg-primary",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td><small class="text-muted">@member.Id</small></td>
                                <td>
                                    <strong>@memberName</strong>
                                    <br /><small class="text-muted">@member.User?.UserName</small>
                                </td>
                                <td>@(member.Club?.Name ?? "—")</td>
                                <td>
                                    <span class="badge @roleBadgeClass">@member.Role.GetDisplayName()</span>
                                    @if (member.IsAlsoTrainer)
                                    {
                                        <span class="badge bg-info">+???????</span>
                                    }
                                </td>
                                <td>
                                    @if (trainerName != null)
                                    {
                                        <small>@trainerName</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><small class="text-muted">@member.JoinedAt.ToString("dd.MM.yyyy")</small></td>
                                <td class="text-end">
                                    <form asp-action="DeleteMember" asp-route-id="@member.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('??????? ?? ???, ?? ?????? ?? ?????????? ?????????? ?? @memberName ?? @(member.Club?.Name)?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="???????? ????????">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted">
            ????: @Model.Members.Count() ????????(?)
        </div>
    </div>
</div>
