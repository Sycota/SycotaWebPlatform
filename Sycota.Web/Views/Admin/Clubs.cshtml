@model Sycota.Web.Models.ViewModels.AdminClubsViewModel
@{
    ViewData["Title"] = "?????????? ?? ???????";
}

<div class="container mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">????? ?????</a></li>
            <li class="breadcrumb-item active">???????</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-bullseye me-2"></i>???????</h1>
    </div>

    <!-- Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label class="form-label">???????</label>
                    <input type="text" name="search" class="form-control" placeholder="????? ?? ???, ???????? ??? ?????..." value="@Model.SearchTerm" />
                </div>
                <div class="col-md-3">
                    <div class="d-grid gap-2 d-md-flex">
                        <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i>?????</button>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-action="Clubs" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Clubs Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>???</th>
                            <th>?????</th>
                            <th class="text-center">???????</th>
                            <th class="text-center">?????????</th>
                            <th>????????</th>
                            <th class="text-end">????????</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var club in Model.Clubs)
                        {
                            <tr>
                                <td><small class="text-muted">@club.Id</small></td>
                                <td><strong>@club.Name</strong></td>
                                <td><small>@club.Address</small></td>
                                <td class="text-center"><span class="badge bg-secondary">@club.Members.Count</span></td>
                                <td class="text-center">
                                    @if (club.RequiresApproval)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="??????? ?????????"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle text-muted" title="???????? ??????????????"></i>
                                    }
                                </td>
                                <td><small class="text-muted">@club.CreatedAt.ToString("dd.MM.yyyy")</small></td>
                                <td class="text-end">
                                    <a asp-controller="Clubs" asp-action="Details" asp-route-id="@club.Id" class="btn btn-sm btn-outline-secondary me-1" title="???????">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="EditClub" asp-route-id="@club.Id" class="btn btn-sm btn-outline-primary me-1" title="??????????">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteClub" asp-route-id="@club.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('??????? ?? ???, ?? ?????? ?? ???????? ???? @club.Name? ???? ?? ?????? ?????? ????????, ?????????? ? ???????? ?????.')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="??????">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted">
            ????: @Model.Clubs.Count() ????(?)
        </div>
    </div>
</div>
