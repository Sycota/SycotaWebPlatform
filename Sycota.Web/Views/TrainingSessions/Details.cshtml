@model Sycota.Web.Models.ViewModels.TrainingSessionDetailsViewModel
@{
    ViewData["Title"] = Model.Session.Name;
}

<div class="container mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Clubs" asp-action="Index">Клубове</a></li>
            <li class="breadcrumb-item"><a asp-controller="Clubs" asp-action="Details" asp-route-id="@Model.Session.ClubId">Клуб</a></li>
            <li class="breadcrumb-item"><a asp-controller="Clubs" asp-action="MyResults" asp-route-id="@Model.Session.ClubId">Моите резултати</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Session.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">
                        <i class="bi bi-bullseye me-2"></i>@Model.Session.Name
                    </h2>
                    <span class="badge bg-secondary">@Model.Session.WeaponType</span>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Session.Description))
                    {
                        <p class="lead">@Model.Session.Description</p>
                    }
                    
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <small class="text-muted d-block">Дата</small>
                            <strong><i class="bi bi-calendar me-1"></i>@Model.Session.SessionDate.ToString("dd.MM.yyyy")</strong>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted d-block">Час</small>
                            <strong><i class="bi bi-clock me-1"></i>@Model.Session.SessionDate.ToString("HH:mm")</strong>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted d-block">Стрелец</small>
                            <strong><i class="bi bi-person me-1"></i>@Model.Session.CreatedBy?.UserName</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Session.Notes))
                    {
                        <div class="alert alert-light">
                            <i class="bi bi-journal-text me-1"></i>
                            <strong>Бележки:</strong> @Model.Session.Notes
                        </div>
                    }
                </div>
            </div>

            <!-- Target Visualization -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <i class="bi bi-crosshair me-2"></i>Визуализация на мишената
                </div>
                <div class="card-body text-center" style="background-color: #e8e8e8;">
                    <canvas id="targetCanvas" width="400" height="400" style="border-radius: 8px;"></canvas>
                </div>
            </div>

            <!-- Shot Groups -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <i class="bi bi-list-ol me-2"></i>Детайли за изстрелите
                </div>
                <div class="card-body" id="shotDetails">
                    <!-- Will be populated by JavaScript -->
                </div>
            </div>

            <!-- AI Analysis & Chat -->
            <div class="card shadow-sm mb-5" id="aiAnalysisCard">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-robot me-2"></i>AI Анализ</span>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-secondary me-1" id="clearChatBtn" style="display: none;" title="Изчисти историята">
                            <i class="bi bi-trash"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="analyzeBtn">
                            <i class="bi bi-lightning-charge me-1"></i>Генерирай анализ
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Loading indicator for initial load -->
                    <div id="chatLoading" class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-secondary" role="status">
                            <span class="visually-hidden">Зареждане...</span>
                        </div>
                        <small class="text-muted ms-2">Зареждане на история на чата...</small>
                    </div>
                    
                    <!-- Chat Messages -->
                    <div id="chatMessages" class="mb-3" style="max-height: 400px; overflow-y: auto; display: none;">
                        <div class="text-center text-muted py-4" id="chatPlaceholder">
                            <i class="bi bi-chat-dots display-4"></i>
                            <p class="mt-2">Натиснете "Генерирай анализ" за AI-захранван преглед на вашето представяне и препоръки, как можете да стреляте по-добре.</p>
                        </div>
                    </div>
                    
                    <!-- Chat Input -->
                    <div class="input-group">
                        <input type="text" class="form-control" id="chatInput" placeholder="Задайте въпрос на AI асистента..." maxlength="500">
                        <button class="btn btn-primary" type="button" id="sendBtn" disabled>
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                    <small class="text-muted mt-1 d-block">
                        <i class="bi bi-info-circle me-1"></i>Питайте за техника, какво да подобрите или анализ на групирането. Историята се пази за справка.
                    </small>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Statistics Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <i class="bi bi-graph-up me-2"></i>Статистика
                </div>
                <div class="card-body">
                    <div class="row text-center mb-3">
                        <div class="col-6">
                            <div class="fs-3 fw-bold text-primary" id="totalShots">0</div>
                            <small class="text-muted">Брой изстрели</small>
                        </div>
                        <div class="col-6">
                            <div class="fs-3 fw-bold text-success" id="totalScore">0.0</div>
                            <small class="text-muted">Общ резултат</small>
                        </div>
                    </div>
                    <hr />
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="fs-5 fw-bold" id="avgScore">0.0</div>
                            <small class="text-muted">Средно</small>
                        </div>
                        <div class="col-6">
                            <div class="fs-5 fw-bold" id="tenCount">0</div>
                            <small class="text-muted">10-ки / 10.9</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions Card -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <i class="bi bi-lightning me-2"></i>Действия
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (Model.CanEdit)
                        {
                            <a asp-action="RecordShots" asp-route-id="@Model.Session.Id" class="btn btn-accent">
                                <i class="bi bi-pencil me-1"></i>Редактирай изстрелите
                            </a>
                        }
                        <a asp-controller="Clubs" asp-action="MyResults" asp-route-id="@Model.Session.ClubId" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Назад към резултатите
                        </a>
                        @if (Model.CanEdit)
                        {
                            <hr />
                            <form asp-action="Delete" asp-route-id="@Model.Session.Id" method="post"
                                  onsubmit="return confirm('Сигурни ли сте, че искате да изтриете тази тренировъчна сесия? Всички изстрели от нея ще бъдат изгубени.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger w-100">
                                    <i class="bi bi-trash me-1"></i>Изтрий тренировъчната сесия
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-message {
        margin-bottom: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 1rem;
        max-width: 85%;
    }
    .chat-message.user {
        background-color: #0d6efd;
        color: white;
        margin-left: auto;
        border-bottom-right-radius: 0.25rem;
    }
    .chat-message.assistant {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-bottom-left-radius: 0.25rem;
    }
    .chat-message.assistant .message-content {
        white-space: pre-wrap;
    }
    .chat-message .message-label {
        font-size: 0.75rem;
        opacity: 0.7;
        margin-bottom: 0.25rem;
    }
    .typing-indicator {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
    }
    .typing-indicator span {
        height: 8px;
        width: 8px;
        background-color: #6c757d;
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
        animation: typing 1s infinite;
    }
    .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
    .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
    @@keyframes typing {
        0%, 60%, 100% { transform: translateY(0); }
        30% { transform: translateY(-5px); }
    }
</style>

@section Scripts {
<script>
(function() {
    const sessionId = @Model.Session.Id;
    const shotsData = @Html.Raw(Model.Session.Shots ?? "{\"warmupShots\":[],\"groups\":[]}");
    
    const canvas = document.getElementById('targetCanvas');
    const ctx = canvas.getContext('2d');
    const scale = 8;
    const offsetX = canvas.width / 2;
    const offsetY = canvas.height / 2;
    
    // Chat state
    let chatHistory = [];
    let isLoading = false;
    
    // ISSF 10m Air Rifle Target specifications (in mm)
    const RING_RADII = [
        { ring: 10, radius: 0.5 },
        { ring: 9, radius: 2.5 },
        { ring: 8, radius: 5.0 },
        { ring: 7, radius: 7.5 },
        { ring: 6, radius: 10.0 },
        { ring: 5, radius: 12.5 },
        { ring: 4, radius: 15.0 },
        { ring: 3, radius: 17.5 },
        { ring: 2, radius: 20.0 },
        { ring: 1, radius: 22.5 }
    ];
    
    const PELLET_RADIUS = 2.25;
    const CENTER_DOT_RADIUS = 0.25;

    function calculateScore(x, y) {
        const dist = Math.sqrt(x * x + y * y);
        const innerEdge = Math.max(0, dist - PELLET_RADIUS);
        
        const ring9Radius = 0.25;
        if (innerEdge <= ring9Radius) {
            const maxCenterDistForTen = 2.5;
            const positionRatio = Math.min(dist / maxCenterDistForTen, 1);
            const decimalScore = 10.9 - (positionRatio * 0.9);
            return Math.round(decimalScore * 10) / 10;
        }
        
        for (let ring = 9; ring >= 1; ring--) {
            const ringData = RING_RADII.find(r => r.ring === ring);
            const prevRingData = RING_RADII.find(r => r.ring === ring + 1);
            const innerRadius = prevRingData ? prevRingData.radius : ring9Radius;
            const outerRadius = ringData.radius;
            
            if (innerEdge <= outerRadius) {
                const positionInRing = (innerEdge - innerRadius) / (outerRadius - innerRadius);
                const decimalScore = (ring + 0.9) - (positionInRing * 0.9);
                return Math.round(decimalScore * 10) / 10;
            }
        }
        
        return 0;
    }

    function drawTarget() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#f5f0e6';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        ctx.save();
        ctx.translate(offsetX, offsetY);
        
        ctx.beginPath();
        ctx.arc(0, 0, 22.5 * scale, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        
        for (let ring = 1; ring <= 4; ring++) {
            const ringData = RING_RADII.find(r => r.ring === ring);
            ctx.beginPath();
            ctx.arc(0, 0, ringData.radius * scale, 0, Math.PI * 2);
            ctx.strokeStyle = '#000000';
            ctx.lineWidth = 0.6;
            ctx.stroke();
        }
        
        const ring4Data = RING_RADII.find(r => r.ring === 4);
        ctx.beginPath();
        ctx.arc(0, 0, ring4Data.radius * scale, 0, Math.PI * 2);
        ctx.fillStyle = '#000000';
        ctx.fill();
        
        for (let ring = 5; ring <= 9; ring++) {
            const ringData = RING_RADII.find(r => r.ring === ring);
            ctx.beginPath();
            ctx.arc(0, 0, ringData.radius * scale, 0, Math.PI * 2);
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 0.4;
            ctx.stroke();
        }
        
        ctx.beginPath();
        ctx.arc(0, 0, CENTER_DOT_RADIUS * scale, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        
        ctx.font = `bold ${6 * scale / 10}px Arial`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        for (let ring = 1; ring <= 3; ring++) {
            const currentRingData = RING_RADII.find(r => r.ring === ring);
            const nextRingData = RING_RADII.find(r => r.ring === ring + 1);
            const labelRadius = (currentRingData.radius + nextRingData.radius) / 2 * scale;
            ctx.fillStyle = '#000000';
            ctx.fillText(String(ring), labelRadius, 0);
            ctx.fillText(String(ring), -labelRadius, 0);
            ctx.fillText(String(ring), 0, labelRadius);
            ctx.fillText(String(ring), 0, -labelRadius);
        }
        
        for (let ring = 4; ring <= 8; ring++) {
            const currentRingData = RING_RADII.find(r => r.ring === ring);
            const nextRingData = RING_RADII.find(r => r.ring === ring + 1);
            const labelRadius = (currentRingData.radius + nextRingData.radius) / 2 * scale;
            ctx.fillStyle = '#ffffff';
            ctx.fillText(String(ring), labelRadius, 0);
            ctx.fillText(String(ring), -labelRadius, 0);
            ctx.fillText(String(ring), 0, labelRadius);
            ctx.fillText(String(ring), 0, -labelRadius);
        }
        
        const pelletRadius = PELLET_RADIUS * scale;
        const colors = ['#6c757d', '#dc3545', '#0d6efd', '#198754', '#fd7e14', '#6f42c1'];
        
        (shotsData.warmupShots || []).forEach((shot, i) => {
            drawShot(shot, pelletRadius, colors[0], i + 1);
        });
        
        (shotsData.groups || []).forEach((group, gi) => {
            const color = colors[(gi % 5) + 1];
            (group.shots || []).forEach((shot, i) => {
                drawShot(shot, pelletRadius, color, i + 1);
            });
        });
        
        ctx.restore();
    }

    function drawShot(shot, pelletRadius, color, num) {
        ctx.beginPath();
        ctx.arc(shot.x * scale, shot.y * scale, pelletRadius, 0, Math.PI * 2);
        ctx.fillStyle = color;
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1;
        ctx.stroke();
        
        ctx.fillStyle = '#ffffff';
        ctx.strokeStyle = '#000000';
        ctx.lineWidth = 1.5;
        ctx.font = 'bold 9px Arial';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.strokeText(String(num), shot.x * scale, shot.y * scale);
        ctx.fillText(String(num), shot.x * scale, shot.y * scale);
    }

    function updateStatistics() {
        let allShots = [...(shotsData.warmupShots || [])];
        let scoredShots = [];
        
        (shotsData.groups || []).forEach(group => {
            allShots = [...allShots, ...(group.shots || [])];
            scoredShots = [...scoredShots, ...(group.shots || [])];
        });
        
        let totalScore = 0;
        let tenCount = 0;
        
        scoredShots.forEach(shot => {
            const score = calculateScore(shot.x, shot.y);
            totalScore += score;
            if (score >= 10) tenCount++;
        });
        
        document.getElementById('totalShots').textContent = allShots.length;
        document.getElementById('totalScore').textContent = totalScore.toFixed(1);
        document.getElementById('avgScore').textContent = scoredShots.length > 0 ? (totalScore / scoredShots.length).toFixed(2) : '0.0';
        document.getElementById('tenCount').textContent = tenCount;
    }

    function renderShotDetails() {
        const container = document.getElementById('shotDetails');
        let html = '';
        
        if (shotsData.warmupShots && shotsData.warmupShots.length > 0) {
            html += '<h6><i class="bi bi-thermometer-half me-1"></i>Загряване</h6>';
            html += renderShotTable(shotsData.warmupShots, false);
        }
        
        const seriesGroups = (shotsData.groups || []).filter(g => g.valueType === '10-shot-series');
        
        if (seriesGroups.length > 0) {
            html += '<h6 class="mt-3"><i class="bi bi-calculator me-1"></i>Обобщение на сериите</h6>';
            html += '<table class="table table-sm" style="background: #fff;"><thead><tr><th>Серия</th><th class="text-end">Резултат</th></tr></thead><tbody>';
            
            let grandTotal = 0;
            let seriesIndex = 0;
            (shotsData.groups || []).forEach((group, i) => {
                if (group.valueType !== '10-shot-series') return;
                seriesIndex++;
                let seriesScore = 0;
                (group.shots || []).forEach(shot => {
                    seriesScore += calculateScore(shot.x, shot.y);
                });
                grandTotal += seriesScore;
                const shotCount = (group.shots || []).length;
                const statusClass = shotCount === 10 ? 'text-success' : (shotCount > 0 ? 'text-warning' : 'text-muted');
                html += `<tr><td><i class="bi bi-bullseye me-1 ${statusClass}"></i>Серия ${seriesIndex} <small class="text-muted">(${shotCount}/10)</small></td><td class="text-end fw-bold">${seriesScore.toFixed(1)}</td></tr>`;
            });
            
            html += `</tbody><tfoot class="table-active"><tr><td><strong>Общо</strong></td><td class="text-end"><strong>${grandTotal.toFixed(1)}</strong></td></tr></tfoot></table>`;
        }
        
        (shotsData.groups || []).forEach((group, i) => {
            if (group.shots && group.shots.length > 0) {
                const typeIcon = group.valueType === 'blind' ? 'eye-slash' : 
                                group.valueType === 'practice' ? 'flag' : 'bullseye';
                const typeName = group.valueType === 'blind' ? 'На сляпо' : 
                                group.valueType === 'practice' ? 'Практика' : '10-изстрелна серия';
                html += `<h6 class="mt-3"><i class="bi bi-${typeIcon} me-1"></i>Серия ${i + 1} <span class="badge bg-secondary">${typeName}</span></h6>`;
                const showTotal = group.valueType === '10-shot-series';
                html += renderShotTable(group.shots, showTotal);
            }
        });
        
        if (!html) {
            html = '<p class="text-muted text-center"><i class="bi bi-bullseye me-1"></i>Все още няма записани изстрели.</p>';
        }
        
        container.innerHTML = html;
    }

    function renderShotTable(shots, showTotal = false) {
        let html = '<table class="table table-sm" style="background: #fff;"><thead><tr><th>#</th><th>Позиция (мм)</th><th>Резултат</th></tr></thead><tbody>';
        let total = 0;
        
        shots.forEach((shot, i) => {
            const score = calculateScore(shot.x, shot.y);
            total += score;
            let scoreClass = '';
            if (score >= 10.5) scoreClass = 'text-success fw-bold';
            else if (score >= 10) scoreClass = 'text-success';
            else if (score >= 9) scoreClass = 'text-primary';
            else scoreClass = 'text-dark';
            
            html += `<tr><td><span class="badge bg-secondary">${i + 1}</span></td><td class="small font-monospace">(${shot.x.toFixed(1)}, ${shot.y.toFixed(1)})</td><td class="${scoreClass} fw-bold">${score.toFixed(1)}</td></tr>`;
        });
        
        if (showTotal && shots.length > 0) {
            html += `<tr class="table-active"><td colspan="2"><strong>Общо за серията</strong></td><td><strong>${total.toFixed(1)}</strong></td></tr>`;
        }
        
        html += '</tbody></table>';
        return html;
    }

    // AI Chat Functions
    function addChatMessage(role, content) {
        const container = document.getElementById('chatMessages');
        const placeholder = document.getElementById('chatPlaceholder');
        if (placeholder) placeholder.remove();
        
        const messageDiv = document.createElement('div');
        messageDiv.className = `chat-message ${role}`;
        
        const labelDiv = document.createElement('div');
        labelDiv.className = 'message-label';
        labelDiv.textContent = role === 'user' ? 'Вие' : 'AI Анализатор';
        
        const contentDiv = document.createElement('div');
        contentDiv.className = 'message-content';
        contentDiv.textContent = content;
        
        messageDiv.appendChild(labelDiv);
        messageDiv.appendChild(contentDiv);
        container.appendChild(messageDiv);
        
        container.scrollTop = container.scrollHeight;
        
        // Show clear button if we have messages
        document.getElementById('clearChatBtn').style.display = 'inline-block';
    }
    
    function showTypingIndicator() {
        const container = document.getElementById('chatMessages');
        const indicator = document.createElement('div');
        indicator.id = 'typingIndicator';
        indicator.className = 'typing-indicator chat-message assistant';
        indicator.innerHTML = '<span></span><span></span><span></span>';
        container.appendChild(indicator);
        container.scrollTop = container.scrollHeight;
    }
    
    function hideTypingIndicator() {
        const indicator = document.getElementById('typingIndicator');
        if (indicator) indicator.remove();
    }
    
    function setLoading(loading) {
        isLoading = loading;
        document.getElementById('analyzeBtn').disabled = loading;
        document.getElementById('sendBtn').disabled = loading || !document.getElementById('chatInput').value.trim();
        document.getElementById('chatInput').disabled = loading;
    }
    
    async function loadChatHistory() {
        try {
            const response = await fetch(`/api/AiAnalysis/history/${sessionId}`);
            const data = await response.json();
            
            document.getElementById('chatLoading').style.display = 'none';
            document.getElementById('chatMessages').style.display = 'block';
            
            if (response.ok && data.messages && data.messages.length > 0) {
                // Load existing messages
                data.messages.forEach(msg => {
                    chatHistory.push({ role: msg.role, content: msg.content });
                    addChatMessage(msg.role, msg.content);
                });
                
                // Hide analyze button text if already analyzed
                const hasAnalysis = data.messages.some(m => m.role === 'assistant');
                if (hasAnalysis) {
                    document.getElementById('analyzeBtn').innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Прегенерирай анализ';
                }
            }
        } catch (error) {
            document.getElementById('chatLoading').style.display = 'none';
            document.getElementById('chatMessages').style.display = 'block';
            console.error('Failed to load chat history:', error);
        }
    }
    
    async function analyzeSession() {
        if (isLoading) return;
        setLoading(true);
        showTypingIndicator();
        
        try {
            const response = await fetch(`/api/AiAnalysis/analyze/${sessionId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            
            const data = await response.json();
            hideTypingIndicator();
            
            if (response.ok && data.analysis) {
                // Only add to local history if it's not cached (new analysis)
                if (!data.cached) {
                    chatHistory.push({ role: 'assistant', content: data.analysis });
                }
                addChatMessage('assistant', data.analysis);
                document.getElementById('analyzeBtn').innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Прегенерирай анализ';
            } else {
                addChatMessage('assistant', `Съжалявам, не успях да генерирам анализа: ${data.error || 'Неизвестна грешка'}`);
            }
        } catch (error) {
            hideTypingIndicator();
            addChatMessage('assistant', 'Съжалявам, възникна грешка при свързване с AI сървъра. Моля, опитайте отново по-късно.');
        }
        
        setLoading(false);
    }
    
    async function sendChatMessage() {
        const input = document.getElementById('chatInput');
        const message = input.value.trim();
        if (!message || isLoading) return;
        
        input.value = '';
        addChatMessage('user', message);
        
        setLoading(true);
        showTypingIndicator();
        
        try {
            const response = await fetch(`/api/AiAnalysis/chat/${sessionId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: message })
            });
            
            const data = await response.json();
            hideTypingIndicator();
            
            if (response.ok && data.response) {
                chatHistory.push({ role: 'user', content: message });
                chatHistory.push({ role: 'assistant', content: data.response });
                addChatMessage('assistant', data.response);
            } else {
                addChatMessage('assistant', `Съжалявам, не успях да отговоря: ${data.error || 'Неизвестна грешка'}`);
            }
        } catch (error) {
            hideTypingIndicator();
            addChatMessage('assistant', 'Съжалявам, възникна грешка при свързване с AI сървъра. Моля, опитайте отново по-късно.');
        }
        
        setLoading(false);
    }
    
    async function clearChatHistory() {
        if (!confirm('Сигурни ли сте, че искате да изчистите историята на чата завинаги? Това не може да бъде възстановено.')) {
            return;
        }
        
        try {
            const response = await fetch(`/api/AiAnalysis/history/${sessionId}`, {
                method: 'DELETE'
            });
            
            if (response.ok) {
                // Clear UI
                chatHistory = [];
                const container = document.getElementById('chatMessages');
                container.innerHTML = `
                    <div class="text-center text-muted py-4" id="chatPlaceholder">
                        <i class="bi bi-chat-dots display-4"></i>
                        <p class="mt-2">Натиснете "Генерирай анализ" за AI-захранван преглед на вашето представяне и препоръки, как можете да стреляте по-добре.</p>
                    </div>
                `;
                document.getElementById('clearChatBtn').style.display = 'none';
                document.getElementById('analyzeBtn').innerHTML = '<i class="bi bi-lightning-charge me-1"></i>Генерирай анализ';
            }
        } catch (error) {
            console.error('Failed to clear chat history:', error);
        }
    }
    
    // Event Listeners
    document.getElementById('analyzeBtn').addEventListener('click', analyzeSession);
    document.getElementById('sendBtn').addEventListener('click', sendChatMessage);
    document.getElementById('clearChatBtn').addEventListener('click', clearChatHistory);
    
    document.getElementById('chatInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendChatMessage();
        }
    });
    
    document.getElementById('chatInput').addEventListener('input', function() {
        document.getElementById('sendBtn').disabled = !this.value.trim() || isLoading;
    });

    // Initialize
    drawTarget();
    updateStatistics();
    renderShotDetails();
    loadChatHistory(); // Load saved chat history on page load
})();
</script>
}
